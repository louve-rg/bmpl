{
  "name": "@bmpl/api",
  "version": "0.1.0",
  "private": true,
  "description": "BMPL backend API (NestJS) — the single source of authorization.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@bmpl/authentication": "workspace:*",
    "@bmpl/authorization": "workspace:*",
    "@bmpl/database": "workspace:*",
    "@bmpl/notifications": "workspace:*",
    "@bmpl/shared": "workspace:*",
    "@bmpl/validation": "workspace:*",
    "@bmpl/wallet": "workspace:*",
    "@aws-sdk/client-s3": "^3.645.0",
    "@aws-sdk/s3-request-presigner": "^3.645.0",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "supertest": "^7.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@types/supertest": "^6.0.2",
    "unplugin-swc": "^1.5.1",
    "@swc/core": "^1.7.26"
  }
}
