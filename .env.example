# =============================================================================
# BMPL — Belize Marketplace & Logistics — Environment Template
# Copy to `.env` at the repo root:  cp .env.example .env
# NEVER commit the real .env. All secrets below are DEV PLACEHOLDERS — rotate
# and replace for any shared/staging/production environment.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development

# ---- Database (PostgreSQL) --------------------------------------------------
# Matches docker-compose.yml. DIRECT_URL is used by Prisma for migrations.
DATABASE_URL="postgresql://bmpl:bmpl_dev_password@localhost:5432/bmpl?schema=public"
DIRECT_URL="postgresql://bmpl:bmpl_dev_password@localhost:5432/bmpl?schema=public"
# Disposable database used ONLY by the integration test suite
# (pnpm --filter @bmpl/api test:integration). Must differ from DATABASE_URL —
# the suite truncates data between tests.
TEST_DATABASE_URL="postgresql://bmpl:bmpl_dev_password@localhost:5432/bmpl_test?schema=public"

# ---- Redis (:6379) ----------------------------------------------------------
# Provisioned in dev and checked by the API readiness probe (/api/health/ready).
# NOTE: no Phase 1 business feature depends on Redis yet (queues/cache/rate-limit
# land in a later phase); it is wired only into the health check for now.
REDIS_URL="redis://localhost:6379"

# Every git worktree on this host shares the SAME local Redis (and the same
# Postgres) by default. Scheduler lock keys (dispatch/shipping-dispatch/
# payments-reconciliation sweeps) are plain constants, so two API processes
# from two different worktrees will silently fight over each other's lock and
# one will win ticks the other should have run -- CLOSE-18, found during
# CLOSE-12's dispatch-exhaustion-recovery verification. Set this to something
# unique per worktree (e.g. the worktree's own folder name) and every
# scheduler's lock key is prefixed with it automatically (see RedisService#lockKey).
# LEAVE UNSET in any shared/production environment -- two production replicas
# correctly sharing one lock must keep working unchanged.
# REDIS_LOCK_NAMESPACE="bmpl-qa2"

# ---- API ---------------------------------------------------------------------
API_PORT=4000
API_URL="http://localhost:4000"
# Comma-separated list of allowed browser origins (web + admin apps).
# Includes :3177, apps/web/e2e's dedicated Playwright port (BMPL-217/228) --
# without it, any mutating request from that suite gets a same-shaped-but-
# wrong 403 ("Request origin is not allowed"), not a clean failure.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3177"

# ---- Auth secrets (GENERATE STRONG RANDOM VALUES) ---------------------------
# e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-only-change-me-access-secret"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
COOKIE_SECRET="dev-only-change-me-cookie-secret"
COOKIE_DOMAIN="localhost"

# ---- Object storage (S3-compatible: MinIO in dev, R2/S3/Supabase in prod) ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="bmpl-documents"
STORAGE_ACCESS_KEY_ID="bmpl"
STORAGE_SECRET_ACCESS_KEY="bmpl_dev_password"
STORAGE_FORCE_PATH_STYLE=true
# Signed-URL lifetime (seconds) for private document access
STORAGE_SIGNED_URL_TTL=300

# ---- Profile-picture face check ---------------------------------------------
# "none" (default) queues every uploaded profile picture for admin review.
# Set to "google" + a Cloud Vision API key to auto-approve/reject on a face check.
AVATAR_VISION_PROVIDER=none
GOOGLE_VISION_API_KEY=""
AVATAR_VISION_TIMEOUT_MS=8000

# ---- Email (dev: log transport; prod: SMTP/Resend/SES) ----------------------
EMAIL_TRANSPORT=console
EMAIL_FROM="Belize Marketplace & Logistics <no-reply@bzemarketplace.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# ---- Push notifications (Expo) ----------------------------------------------
EXPO_ACCESS_TOKEN=""

# ---- Maps (delivery / passenger / real estate) ------------------------------
# Placeholder — supply a real key before enabling map features.
MAPS_PROVIDER="maplibre"
MAPS_API_KEY=""

# ---- Web app (Next.js, public) ----------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Admin app (Next.js) ----------------------------------------------------
ADMIN_PUBLIC_API_URL="http://localhost:4000"
ADMIN_SITE_URL="http://localhost:3001"

# ---- Mobile app (Expo) ------------------------------------------------------
EXPO_PUBLIC_API_URL="http://localhost:4000"

# ---- Seed (development accounts) --------------------------------------------
# The default super-admin password below is UNSAFE — for local development only.
# Set a strong SEED_SUPER_ADMIN_PASSWORD and rotate the account before any shared
# or production deployment. Demo customers are only seeded when NODE_ENV != production.
SEED_SUPER_ADMIN_EMAIL="admin@bzemarketplace.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe!Admin123"
SEED_DEMO_PASSWORD="DemoPass123"

# seed-uat-logistics.ts and seed-uat-roles.ts (packages/database/prisma) drive
# a real API over HTTP and REQUIRE this — no default (FLOOR-SEEDTARGET,
# 2026-11-10). On a machine running more than one local BMPL stack, every
# stack's database is named "bmpl" by this same file's own default, so a
# missing API target cannot be told apart from a real one by checking
# DATABASE_URL alone; it would otherwise silently fall through to whatever
# happens to be listening on localhost, which may belong to someone else.
UAT_SEED_API_URL="http://localhost:4000"

# ---- TEMPORARY: self-service UAT wallet funding -----------------------------
# MUST BE OFF BEFORE COMMERCIAL LAUNCH.
#
# Lets a signed-in tester issue THEMSELVES a one-off simulation credit, so UAT
# does not need a card, a bank, a gateway or an administrator. The money is
# real ledger money in every mechanical sense — double-entry, escrowed, settled
# — and marked isTest throughout, so it never reaches revenue reporting or a
# payout.
#
# The kill switch is this flag and it defaults to OFF, including when the
# variable is absent. Deploying without setting it therefore turns the feature
# off by itself. Deliberately NOT keyed on NODE_ENV: UAT runs on the live
# stack, so the environment cannot be what decides.
#
# The cap is CUMULATIVE and enforced server-side: BZ$250 once per account, not
# BZ$250 topped back up whenever it is spent. The client sends no amount, no
# user and no wallet — all three come from the session and this configuration.
ENABLE_SELF_SERVICE_TEST_FUNDING="false"
# Optional. Capped at 25000 (BZ$250.00) whatever this says.
SELF_SERVICE_TEST_FUNDING_AMOUNT_MINOR="25000"
# Optional belt-and-braces: an ISO timestamp after which the feature disables
# itself even if somebody forgets the flag. Absent means no expiry.
SELF_SERVICE_TEST_FUNDING_EXPIRES_AT=""
