// =============================================================================
// BMPL — Belize Marketplace & Logistics — Prisma schema (Phase 1)
//
// Design principles:
//  * ONE user account holds MANY roles. Each (user, role) pair is a UserRole
//    row with its OWN independent status. There is NO single role column on User.
//  * Admin capability lives on AdminPermissionGrant, a SEPARATE axis from
//    customer-facing roles.
//  * Every privileged action writes an AuditLog row.
//  * Wallet uses a DOUBLE-ENTRY ledger. Balances are DERIVED from WalletLedgerEntry
//    rows; there is no editable balance field as the source of truth.
//  * Uploaded documents are stored as opaque storage KEYS only — never public URLs.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" for the local host; the Debian target is for the Railway Docker
  // runtime (node:24-bookworm-slim => debian-openssl-3.0.x).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- Enums ------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

// Moderation state of a user's profile picture. A picture is only ever shown to
// other users at APPROVED; every other state falls back to generated initials.
enum AvatarStatus {
  NONE // never uploaded, or the user removed theirs
  PENDING // uploaded, awaiting the automated face check or an admin decision
  APPROVED // verified to contain a single human face and safe content
  REJECTED // failed the check (no face, multiple faces, unsafe content, …)
}

enum District {
  BELIZE
  CAYO
  COROZAL
  ORANGE_WALK
  STANN_CREEK
  TOLEDO
}

enum RoleCode {
  CUSTOMER
  VENDOR
  DELIVERY_DRIVER
  SHIPPING_PROVIDER
  PASSENGER_DRIVER
