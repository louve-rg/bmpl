// =============================================================================
// BMPL — Belize Marketplace & Logistics — Prisma schema (Phase 1)
//
// Design principles:
//  * ONE user account holds MANY roles. Each (user, role) pair is a UserRole
//    row with its OWN independent status. There is NO single role column on User.
//  * Admin capability lives on AdminPermissionGrant, a SEPARATE axis from
//    customer-facing roles.
//  * Every privileged action writes an AuditLog row.
//  * Wallet uses a DOUBLE-ENTRY ledger. Balances are DERIVED from WalletLedgerEntry
//    rows; there is no editable balance field as the source of truth.
//  * Uploaded documents are stored as opaque storage KEYS only — never public URLs.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // "native" for the local host; the Debian target is for the Railway Docker
  // runtime (node:24-bookworm-slim => debian-openssl-3.0.x).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- Enums ------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum District {
  BELIZE
  CAYO
  COROZAL
  ORANGE_WALK
  STANN_CREEK
  TOLEDO
}

enum RoleCode {
  CUSTOMER
  VENDOR
  DELIVERY_DRIVER
  SHIPPING_PROVIDER
  PASSENGER_DRIVER
  PASSENGER_PROVIDER
  JOB_SEEKER
  EMPLOYER
  REAL_ESTATE_AGENT
  PROPERTY_OWNER
  MARKETING_CLIENT
  SUPPORT_AGENT
  ADMIN
  SUPER_ADMIN
}

// Independent lifecycle status for a single UserRole.
enum RoleStatus {
  PENDING
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
  REVOKED
}

enum RoleApplicationStatus {
  PENDING
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

// A single administrative decision recorded against an application.
enum ReviewAction {
  SUBMITTED
  MORE_INFO_REQUESTED
  INFO_PROVIDED
  APPROVED
  REJECTED
  SUSPENDED
  RESTORED
  REVOKED
}

enum NotificationType {
  ACCOUNT
  ROLE_APPLICATION
  ROLE_STATUS
  SECURITY
  SYSTEM
  MARKETPLACE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGGED_IN
  USER_SUSPENDED
  USER_RESTORED
  EMAIL_VERIFIED
  PASSWORD_RESET
  ROLE_APPLICATION_SUBMITTED
  ROLE_APPLICATION_MORE_INFO_REQUESTED
  ROLE_APPLICATION_INFO_PROVIDED
  ROLE_APPROVED
  ROLE_REJECTED
  ROLE_SUSPENDED
  ROLE_RESTORED
  ROLE_REVOKED
  ROLE_SWITCHED
  ADMIN_PERMISSION_GRANTED
  ADMIN_PERMISSION_REVOKED
  NOTIFICATION_BROADCAST
  // ---- Marketplace: Categories (Phase 2 · M1) ----
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  // ---- Marketplace: Vendors (Phase 2 · M2) ----
  VENDOR_PROFILE_SUBMITTED
  VENDOR_APPROVED
  VENDOR_REJECTED
  VENDOR_SUSPENDED
  VENDOR_RESTORED
  // ---- Marketplace: Products (Phase 2 · M4) ----
  PRODUCT_CREATED
  PRODUCT_SUBMITTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_SUSPENDED
  PRODUCT_ARCHIVED
  PRODUCT_DELETED
  // ---- Marketplace: Inventory (Phase 2 · M6) ----
  INVENTORY_ADJUSTED
}

enum WalletAccountType {
  USER
  SYSTEM_ESCROW
  SYSTEM_PLATFORM_FEES
  SYSTEM_TOPUP_CLEARING
  SYSTEM_PAYOUTS_CLEARING
}

enum WalletTransactionType {
  TOPUP
  PAYMENT
  VENDOR_EARNING
  DRIVER_EARNING
  REFUND
  ESCROW_HOLD
  ESCROW_RELEASE
  PLATFORM_FEE
  TRANSFER
  WITHDRAWAL
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum Currency {
  BZD
  USD
}

// ---- Identity ---------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  district      District?
  addressLine1  String?
  addressLine2  String?
  city          String?
  avatarKey     String? // private storage key; served via signed URL
  status        UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  suspendedAt   DateTime?
  suspendedReason String?
  lastLoginAt   DateTime?
  acceptedTermsAt DateTime?

  // The user's currently active role in the switcher (must be an APPROVED UserRole).
  activeRoleCode RoleCode? @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                UserRole[]
  sessions             Session[]
  emailTokens          EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  roleApplications     RoleApplication[]
  adminPermissions     AdminPermissionGrant[]      @relation("PermissionHolder")
  grantedPermissions   AdminPermissionGrant[]      @relation("PermissionGrantedBy")
  notifications        Notification[]
  auditLogsAsActor     AuditLog[]                  @relation("AuditActor")
  auditLogsAsTarget    AuditLog[]                  @relation("AuditTarget")
  reviewsPerformed     RoleApplicationReview[]     @relation("ReviewReviewer")
  walletAccounts       WalletAccount[]
  vendorProfile        VendorProfile?              @relation("UserVendorProfile")
  vendorReviewsMade    VendorModerationReview[]    @relation("VendorReviewer")
  productReviewsMade   ProductModerationReview[]   @relation("ProductReviewer")
  inventoryChangesMade InventoryChange[]           @relation("InventoryActor")

  @@index([status])
  @@index([district])
  @@map("users")
}

// Server-side, revocable session. Access token is a short-lived JWT; the refresh
// token's HASH is stored here and rotated on use. Deleting the row revokes access.
model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  client           String   @default("web") // "web" | "admin" | "mobile"
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---- Roles ------------------------------------------------------------------

// Catalog of role definitions (seeded, one row per RoleCode).
model Role {
  code             RoleCode @id
  label            String
  description      String
  isAdminRole      Boolean  @default(false)
  requiresApproval Boolean  @default(true)
  autoGranted      Boolean  @default(false)
  createdAt        DateTime @default(now())

  userRoles UserRole[]

  @@map("roles")
}

// One row per (user, role). Each has its OWN status. This is the multi-role core.
model UserRole {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleCode  RoleCode
  role      Role       @relation(fields: [roleCode], references: [code])
  status    RoleStatus @default(PENDING)

  approvedAt   DateTime?
  suspendedAt  DateTime?
  revokedAt    DateTime?
  statusReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications RoleApplication[]

  @@unique([userId, roleCode])
  @@index([roleCode, status])
  @@map("user_roles")
}

// A request for a role. Documents + a chronological review trail hang off it.
model RoleApplication {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleCode   RoleCode
  userRoleId String?
  userRole   UserRole?             @relation(fields: [userRoleId], references: [id], onDelete: SetNull)
  status     RoleApplicationStatus @default(PENDING)
  message    String? // applicant's note

  submittedAt DateTime  @default(now())
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents RoleApplicationDocument[]
  reviews   RoleApplicationReview[]

  @@index([status])
  @@index([roleCode, status])
  @@index([userId])
  @@map("role_applications")
}

// A private uploaded document. `storageKey` is an opaque object-store key; the
// file is NEVER public and is served only through short-lived signed URLs.
model RoleApplicationDocument {
  id            String          @id @default(cuid())
  applicationId String
  application   RoleApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  label         String?
  storageKey    String          @unique
  contentType   String
  sizeBytes     Int
  uploadedAt    DateTime        @default(now())

  @@index([applicationId])
  @@map("role_application_documents")
}

// Immutable record of each decision/step taken on an application.
model RoleApplicationReview {
  id            String          @id @default(cuid())
  applicationId String
  application   RoleApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  action        ReviewAction
  // Null when the actor is the applicant (SUBMITTED / INFO_PROVIDED).
  reviewerId    String?
  reviewer      User?           @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  note          String?
  fromStatus    RoleApplicationStatus?
  toStatus      RoleApplicationStatus?
  createdAt     DateTime        @default(now())

  @@index([applicationId])
  @@map("role_application_reviews")
}

// ---- Admin permissions (separate from customer-facing roles) ----------------

model AdminPermissionGrant {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("PermissionHolder", fields: [userId], references: [id], onDelete: Cascade)
  permission String // value from the shared PERMISSIONS catalog
  grantedById String?
  grantedBy  User?    @relation("PermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
  @@map("admin_permission_grants")
}

// ---- Notifications ----------------------------------------------------------

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  data      Json? // structured payload (e.g. { applicationId })
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

// ---- Audit ------------------------------------------------------------------

model AuditLog {
  id           String      @id @default(cuid())
  action       AuditAction
  actorId      String?
  actor        User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?       @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetRole   RoleCode?
  previousValue Json?
  newValue     Json?
  reason       String?
  ipAddress    String?
  sessionId    String?
  createdAt    DateTime    @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---- Wallet (double-entry ledger foundation) --------------------------------

model WalletAccount {
  id       String            @id @default(cuid())
  type     WalletAccountType
  // Null for SYSTEM_* accounts; set for USER accounts.
  userId   String?
  user     User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency Currency          @default(BZD)
  // Cached, DERIVED balance in minor units (cents). NOT the source of truth —
  // it is recomputed from ledger entries inside the same transaction that posts
  // them. Reconciliation always trusts the sum of WalletLedgerEntry rows.
  cachedBalanceMinor BigInt  @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  entries WalletLedgerEntry[]

  // A user has at most one account per (type, currency); system accounts are unique per (type, currency).
  @@unique([userId, type, currency])
  @@index([type])
  @@map("wallet_accounts")
}

// A logical money movement. Its entries MUST sum to zero (enforced in app code
// and by the balanced-entries invariant in the wallet package).
model WalletTransaction {
  id          String                  @id @default(cuid())
  type        WalletTransactionType
  status      WalletTransactionStatus @default(PENDING)
  currency    Currency                @default(BZD)
  reference   String? // external/idempotency reference
  description String?
  metadata    Json?
  postedAt    DateTime?
  createdAt   DateTime                @default(now())

  entries WalletLedgerEntry[]

  @@unique([reference])
  @@index([type, status])
  @@map("wallet_transactions")
}

model WalletLedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  // RESTRICT (not Cascade): a transaction with posted entries can never be
  // deleted, so ledger history cannot be silently removed by deleting its
  // parent transaction. Corrections are made by posting reversing entries.
  transaction   WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String
  account       WalletAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  direction     LedgerDirection
  // Always positive; direction determines sign. Minor units (cents).
  amountMinor   BigInt
  createdAt     DateTime          @default(now())

  @@index([accountId])
  @@index([transactionId])
  @@map("wallet_ledger_entries")
}

// ---- Marketplace: Categories (Phase 2 · M1) ---------------------------------
// Hierarchical, admin-managed catalog taxonomy. A product references the single
// most-specific Category (added in M4); the parent chain yields the full path.
// Self-referential parent/children with onDelete: Restrict so a category that
// still has children cannot be deleted out from under them.

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  // Icon is a short symbolic name (e.g. a lucide icon key) resolved by the UI.
  iconName    String?
  // Optional hero/thumbnail image stored as a PUBLIC-bucket storage key (never a URL).
  imageKey    String?
  featured    Boolean    @default(false)
  isVisible   Boolean    @default(true)
  sortOrder   Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId, sortOrder])
  @@index([isVisible])
  @@map("categories")
}

// ---- Marketplace: Vendors (Phase 2 · M2) ------------------------------------
// A VENDOR-role user builds ONE business profile. Approval is a separate axis
// from the VENDOR UserRole: the role grants the ability to build a storefront;
// the profile's own approvalStatus gates whether that storefront is public.
// Operational toggles live on VendorSettings so they can grow without touching
// the profile's identity/branding fields.

enum VendorApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum StoreStatus {
  OPEN
  CLOSED
}

enum ModerationAction {
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
  RESTORED
}

model VendorProfile {
  id             String               @id @default(cuid())
  userId         String               @unique
  user           User                 @relation("UserVendorProfile", fields: [userId], references: [id], onDelete: Cascade)
  businessName   String
  slug           String               @unique
  description    String?
  logoKey        String? // public-bucket storage key
  bannerKey      String? // public-bucket storage key
  contactEmail   String
  contactPhone   String?
  website        String?
  socialLinks    Json? // future-ready: { facebook?, instagram?, ... }
  approvalStatus VendorApprovalStatus @default(DRAFT)
  storeStatus    StoreStatus          @default(CLOSED)
  rejectionReason String?
  ratingAverage  Float                @default(0) // placeholder; populated in a later phase
  ratingCount    Int                  @default(0) // placeholder
  submittedAt    DateTime?
  approvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  settings     VendorSettings?
  locations    VendorLocation[]
  openingHours VendorOpeningHours[]
  reviews      VendorModerationReview[]
  products     Product[]

  @@index([approvalStatus])
  @@index([storeStatus])
  @@map("vendor_profiles")
}

model VendorSettings {
  id               String        @id @default(cuid())
  vendorProfileId  String        @unique
  vendorProfile    VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  pickupEnabled    Boolean       @default(true)
  deliveryEnabled  Boolean       @default(false)
  vacationMode     Boolean       @default(false)
  minimumOrderMinor BigInt?
  deliveryRadiusKm Int?
  taxesEnabled     Boolean       @default(false)
  autoAcceptOrders Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("vendor_settings")
}

model VendorLocation {
  id              String        @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  label           String
  addressLine1    String
  addressLine2    String?
  city            String
  district        District
  country         String        @default("BZ")
  latitude        Float?
  longitude       Float?
  isPrimary       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([vendorProfileId])
  @@map("vendor_locations")
}

model VendorOpeningHours {
  id              String        @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  dayOfWeek       Int // 0=Sunday .. 6=Saturday
  openTime        String? // "HH:MM"
  closeTime       String? // "HH:MM"
  isClosed        Boolean       @default(false)

  @@unique([vendorProfileId, dayOfWeek])
  @@map("vendor_opening_hours")
}

model VendorModerationReview {
  id              String           @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile    @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  reviewerId      String?
  reviewer        User?            @relation("VendorReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  action          ModerationAction
  note            String?
  fromStatus      VendorApprovalStatus?
  toStatus        VendorApprovalStatus?
  createdAt       DateTime         @default(now())

  @@index([vendorProfileId])
  @@map("vendor_moderation_reviews")
}

// ---- Marketplace: Products (Phase 2 · M4) -----------------------------------
// Product CORE: identity, categorization (single most-specific categoryId; the
// category parent-chain yields category/subcategory), pricing (minor units),
// SEO, physical dimensions, and the moderation lifecycle. Images (M5) and
// inventory + normalized variants (M6) attach to Product in later milestones.

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
  ARCHIVED
}

model Product {
  id              String        @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title           String
  slug            String        @unique
  description     String?
  sku             String
  barcode         String?
  brand           String?
  status          ProductStatus @default(DRAFT)
  priceMinor      BigInt // minor units (cents), BZD
  salePriceMinor  BigInt?
  currency        Currency      @default(BZD)
  weightGrams     Int?
  lengthMm        Int?
  widthMm         Int?
  heightMm        Int?
  featured        Boolean       @default(false)
  metaTitle       String?
  metaDescription String?
  searchKeywords  String[] // used by the M7 Postgres search
  ratingAverage   Float         @default(0) // placeholder
  ratingCount     Int           @default(0) // placeholder
  publishedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tags      Tag[]                     @relation("ProductTags")
  reviews   ProductModerationReview[]
  images    ProductImage[]
  options   ProductOption[]
  variants  ProductVariant[]
  inventory Inventory[]

  @@unique([vendorProfileId, sku])
  @@index([status])
  @@index([categoryId])
  @@index([vendorProfileId, status])
  @@index([featured])
  @@map("products")
}

// Product image metadata. The binary lives in the PUBLIC object-storage bucket;
// only the opaque storage key is persisted (never a URL). Exactly one image per
// product is primary — enforced transactionally in the service layer.
model ProductImage {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey    String   @unique
  mimeType      String
  fileSizeBytes Int
  width         Int?
  height        Int?
  altText       String?
  caption       String?
  position      Int      @default(0)
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([productId, position])
  @@map("product_images")
}

// ---- Marketplace: Variants & Inventory (Phase 2 · M6) -----------------------
// Fully NORMALIZED variants (no JSON): a product has Options (e.g. "Size"), each
// with Values (e.g. "S","M"); a Variant is a concrete combination linked to one
// Value per option via VariantOptionValue. Inventory attaches either to a Variant
// or, when a product has no variants, to the Product itself (variantId = null).

enum InventoryChangeReason {
  INITIAL
  MANUAL
  RESTOCK
  CORRECTION
  RESERVE
  RELEASE
  BACKORDER
}

model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  values    ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id              String               @id @default(cuid())
  productOptionId String
  option          ProductOption        @relation(fields: [productOptionId], references: [id], onDelete: Cascade)
  value           String
  position        Int                  @default(0)
  variantLinks    VariantOptionValue[]

  @@unique([productOptionId, value])
  @@index([productOptionId])
  @@map("product_option_values")
}

model ProductVariant {
  id             String               @id @default(cuid())
  productId      String
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String?
  barcode        String?
  priceMinor     BigInt? // null = inherit the product price
  salePriceMinor BigInt?
  position       Int                  @default(0)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  optionValues   VariantOptionValue[]
  inventory      Inventory?

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

model VariantOptionValue {
  id                   String             @id @default(cuid())
  variantId            String
  variant              ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productOptionValueId String
  optionValue          ProductOptionValue @relation(fields: [productOptionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, productOptionValueId])
  @@index([productOptionValueId])
  @@map("variant_option_values")
}

model Inventory {
  id                String            @id @default(cuid())
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?           @unique
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int               @default(0) // on-hand
  reserved          Int               @default(0) // allocated (Phase 3 orders); available = quantity - reserved
  lowStockThreshold Int               @default(0)
  unlimited         Boolean           @default(false)
  allowBackorders   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  changes           InventoryChange[]

  // A product-level row has variantId = null; a partial unique index in the
  // migration enforces at most ONE such row per product. Variant rows are unique
  // via variantId @unique above.
  @@index([productId])
  @@map("inventory")
}

model InventoryChange {
  id          String                @id @default(cuid())
  inventoryId String
  inventory   Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  delta       Int // signed change to on-hand quantity
  reason      InventoryChangeReason
  previousQty Int
  newQty      Int
  actorId     String?
  actor       User?                 @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime              @default(now())

  @@index([inventoryId, createdAt])
  @@map("inventory_changes")
}

model Tag {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[] @relation("ProductTags")

  @@map("tags")
}

model ProductModerationReview {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   User?          @relation("ProductReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  action     ModerationAction
  note       String?
  fromStatus ProductStatus?
  toStatus   ProductStatus?
  createdAt  DateTime       @default(now())

  @@index([productId])
  @@map("product_moderation_reviews")
}
