// ---- Property owner profile ----
model PropertyOwnerProfile {
  id                String               @id @default(cuid())
  userId            String               @unique
  user              User                 @relation("UserPropertyOwnerProfile", fields: [userId], references: [id], onDelete: Cascade)
  legalName         String
  displayName       String?
  phone             String?
  email             String?
  district          District?
  contactPreference String? // e.g. EMAIL / PHONE / MESSAGE
  identityVerified  Boolean              @default(false)
  approvalStatus    VendorApprovalStatus @default(DRAFT)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  listings         PropertyListing[]           @relation("OwnerListings")
  assignments      PropertyListingAssignment[]
  promotionTargets PromotionTarget[]

  @@index([approvalStatus])
  @@map("property_owner_profiles")
}

// ---- Real-estate agent profile ----
model RealEstateAgentProfile {
  id               String               @id @default(cuid())
  userId           String               @unique
  user             User                 @relation("UserRealEstateAgentProfile", fields: [userId], references: [id], onDelete: Cascade)
  displayName      String
  legalName        String?
  slug             String               @unique
  photoKey         String? // public bucket
  bio              String?
  phone            String?
  email            String?
  website          String?
  agencyId         String?
  agency           AgencyProfile?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  serviceDistricts District[]
  specialties      AgentSpecialty[]
  yearsExperience  Int?
  approvalStatus   VendorApprovalStatus @default(DRAFT)
  isActive         Boolean              @default(true)
  ratingAverage    Float                @default(0)
  ratingCount      Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  listings         PropertyListing[]           @relation("AgentListings")
  assignments      PropertyListingAssignment[]
  promotionTargets PromotionTarget[]

  @@index([approvalStatus])
  @@index([agencyId])
  @@map("real_estate_agent_profiles")
}

// ---- Agency profile (one manager agent; multi-user teams deferred) ----
model AgencyProfile {
  id             String               @id @default(cuid())
  managerUserId  String               @unique
  manager        User                 @relation("UserAgencyManager", fields: [managerUserId], references: [id], onDelete: Cascade)
  name           String
  legalName      String?
  slug           String               @unique
  logoKey        String?
  bannerKey      String?
  description    String?
  contactEmail   String
  contactPhone   String?
  website        String?
  district       District?
  addressLine1   String?
  city           String?
  approvalStatus VendorApprovalStatus @default(DRAFT)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  agents           RealEstateAgentProfile[]
  listings         PropertyListing[]
  promotionTargets PromotionTarget[]

  @@index([approvalStatus])
  @@map("agency_profiles")
}

// ---- Property listing ----
model PropertyListing {
  id                 String                  @id @default(cuid())
  ownerProfileId     String
  ownerProfile       PropertyOwnerProfile    @relation("OwnerListings", fields: [ownerProfileId], references: [id], onDelete: Cascade)
  agentProfileId     String?
  agentProfile       RealEstateAgentProfile? @relation("AgentListings", fields: [agentProfileId], references: [id], onDelete: SetNull)
  agencyId           String?
  agency             AgencyProfile?          @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  purpose            ListingPurpose
  propertyType       PropertyType
  title              String
  slug               String                  @unique
  reference          String                  @unique // human listing reference
  description        String
  priceMinor         BigInt
  currency           Currency                @default(BZD)
  rentalPeriod       RentalPeriod?
  negotiable         Boolean                 @default(false)
  district           District?
  locality           String?
  // Public approximate location; exact address is PRIVATE (never public unless policy allows).
  generalAddress     String?
  exactAddress       String?
  latitude           Float?
  longitude          Float?
  locationVisibility LocationVisibility      @default(DISTRICT_ONLY)
  bedrooms           Int?
  bathrooms          Int?
  halfBathrooms      Int?
  parkingSpaces      Int?
  propertySize       Float?
  landSize           Float?
  areaUnit           AreaUnit?
  yearBuilt          Int?
  furnishing         Furnishing?
  tenure             Tenure?
  petPolicy          String?
  availabilityDate   DateTime?
  leaseTerm          String?
  condition          String?
  videoUrl           String?
  authorityVerified  Boolean                 @default(false)
  status             PropertyStatus          @default(DRAFT)
  moderationReason   String?
  moderatedById      String?
  moderatedAt        DateTime?
  publishedAt        DateTime?
  soldAt             DateTime?
  rentedAt           DateTime?
  archivedAt         DateTime?
  viewCount          Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  amenities        PropertyAmenity[]
  utilities        PropertyUtility[]
  images           PropertyImage[]
  documents        PropertyDocument[]
  statusHistory    PropertyStatusHistory[]
  priceHistory     PropertyPriceHistory[]
  assignments      PropertyListingAssignment[]
  enquiries        PropertyEnquiry[]
  viewingRequests  PropertyViewingRequest[]
  reports          PropertyReport[]
  savedBy          SavedProperty[]
  viewedBy         RecentlyViewedProperty[]
  promotionTargets PromotionTarget[]

  @@index([status, publishedAt])
  @@index([ownerProfileId, status])
  @@index([agentProfileId, status])
  @@index([district])
  @@index([purpose, propertyType])
  @@map("property_listings")
}

model PropertyAmenity {
  id        String          @id @default(cuid())
  listingId String
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime        @default(now())

  @@unique([listingId, name])
  @@index([listingId])
  @@map("property_amenities")
}

model PropertyUtility {
  id        String          @id @default(cuid())
  listingId String
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime        @default(now())

  @@unique([listingId, name])
  @@index([listingId])
  @@map("property_utilities")
}

model PropertyImage {
  id         String          @id @default(cuid())
  listingId  String
  listing    PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  storageKey String          @unique // public bucket
  altText    String?
  caption    String?
  areaLabel  String? // Exterior / Kitchen / Bedroom / Floor plan / …
  position   Int             @default(0)
  isPrimary  Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@index([listingId, position])
  @@map("property_images")
}

// PRIVATE ownership/authority documents — signed URLs only to owner/assigned agent/permitted admins.
model PropertyDocument {
  id            String               @id @default(cuid())
  listingId     String
  listing       PropertyListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  kind          PropertyDocumentKind
  storageKey    String               @unique // PRIVATE bucket
  label         String?
  mimeType      String
  fileSizeBytes Int
  scanStatus    AttachmentScanStatus @default(PENDING)
  createdAt     DateTime             @default(now())

  @@index([listingId])
  @@map("property_documents")
}

model PropertyStatusHistory {
  id         String          @id @default(cuid())
  listingId  String
  listing    PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromStatus PropertyStatus?
  toStatus   PropertyStatus
  actorId    String?
  note       String?
  createdAt  DateTime        @default(now())

  @@index([listingId, createdAt])
  @@map("property_status_history")
}

model PropertyPriceHistory {
  id         String          @id @default(cuid())
  listingId  String
  listing    PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  priceMinor BigInt
  currency   Currency        @default(BZD)
  createdAt  DateTime        @default(now())

  @@index([listingId, createdAt])
  @@map("property_price_history")
}

// Authority relationship: which owner/agent/agency may manage a listing.
model PropertyListingAssignment {
  id                 String                  @id @default(cuid())
  listingId          String
  listing            PropertyListing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ownerProfileId     String
  ownerProfile       PropertyOwnerProfile    @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  agentProfileId     String?
  agentProfile       RealEstateAgentProfile? @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  agencyId           String?
  status             ListingAssignmentStatus @default(PENDING)
  authorizationDocId String? // references a PropertyDocument (owner authorization / agent mandate)
  assignedAt         DateTime                @default(now())
  acceptedAt         DateTime?
  endedAt            DateTime?

  @@index([listingId])
  @@index([agentProfileId, status])
  @@map("property_listing_assignments")
}

model SavedProperty {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@map("saved_properties")
}

model RecentlyViewedProperty {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewedAt  DateTime        @default(now())

  @@unique([userId, listingId])
  @@index([userId, viewedAt])
  @@map("recently_viewed_properties")
}

model PropertyEnquiry {
  id               String                @id @default(cuid())
  listingId        String
  listing          PropertyListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  enquirerId       String
  enquirer         User                  @relation("EnquirerEnquiries", fields: [enquirerId], references: [id], onDelete: Cascade)
  type             PropertyEnquiryType   @default(GENERAL)
  message          String
  preferredContact String?
  contactPhone     String?
  status           PropertyEnquiryStatus @default(OPEN)
  respondedAt      DateTime?
  closedAt         DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([listingId, status])
  @@index([enquirerId, createdAt])
  @@map("property_enquiries")
}

model PropertyViewingRequest {
  id                 String               @id @default(cuid())
  listingId          String
  listing            PropertyListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requesterId        String
  requester          User                 @relation("RequesterViewings", fields: [requesterId], references: [id], onDelete: Cascade)
  requestedDate      DateTime
  requestedTime      String?
  timezone           String               @default("America/Belize")
  alternateDate      DateTime?
  alternateTime      String?
  message            String?
  status             ViewingRequestStatus @default(REQUESTED)
  confirmedDate      DateTime?
  confirmedTime      String?
  cancellationReason String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  events PropertyViewingEvent[]

  @@index([listingId, status])
  @@index([requesterId, createdAt])
  @@map("property_viewing_requests")
}

model PropertyViewingEvent {
  id         String                 @id @default(cuid())
  requestId  String
  request    PropertyViewingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus ViewingRequestStatus?
  toStatus   ViewingRequestStatus
  actorId    String?
  note       String?
  createdAt  DateTime               @default(now())

  @@index([requestId, createdAt])
  @@map("property_viewing_events")
}

model PropertyReport {
  id             String               @id @default(cuid())
  listingId      String
  listing        PropertyListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId     String
  reason         PropertyReportReason
  note           String?
  status         PropertyReportStatus @default(OPEN)
  resolvedById   String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())

  @@unique([listingId, reporterId])
  @@index([status])
  @@map("property_reports")
}

// ===========================================================================
// Marketing & Business Promotion (Phase 6 · M26)
// Promotions are normalized (no JSON blobs). A promotion targets existing
// entities (there is no separate "Business" model) via typed nullable FKs on
// PromotionTarget. Public serving validates the target's own live status at
// query time, so a suspended/unpublished/deleted target automatically stops
// showing — no cascade toggles. Money is BZD minor units (BigInt), matching
// the wallet/order convention, WITHOUT touching wallet or payment logic.
// ===========================================================================

enum CampaignType {
  SEASONAL
  LIMITED_TIME
  SALE
  COUPON
  DISCOUNT
  FEATURED
  ANNOUNCEMENT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  EXPIRED
  ARCHIVED
}

enum PromotionType {
  FEATURED_BUSINESS
  FEATURED_STORE
  FEATURED_PRODUCT
  FEATURED_PROPERTY
  FEATURED_JOB
  HOMEPAGE_BANNER
  CATEGORY_BANNER
  ANNOUNCEMENT_BANNER
  LIMITED_TIME
  COUPON_CAMPAIGN
  DISCOUNT_CAMPAIGN
  SEASONAL_CAMPAIGN
  HOMEPAGE_HERO
}

enum PromotionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  PAUSED
  EXPIRED
  ARCHIVED
}

enum PromotionTargetType {
  VENDOR
  EMPLOYER
  AGENCY
  AGENT
  PROPERTY_OWNER
  PRODUCT
  JOB
  PROPERTY
  EXTERNAL_LINK
  NONE
}

enum PromotionPlacementType {
  HOMEPAGE_HERO
  HOMEPAGE_FEATURED_BUSINESSES
  HOMEPAGE_FEATURED_PRODUCTS
  HOMEPAGE_FEATURED_JOBS
  HOMEPAGE_FEATURED_PROPERTIES
  CATEGORY_PAGE
  BUSINESS_PAGE
  MARKETPLACE
  JOBS
  REAL_ESTATE
  SEARCH
  DISCOVERY
}

enum PromotionAssetKind {
  DESKTOP_BANNER
  MOBILE_BANNER
  SQUARE_IMAGE
  HERO_IMAGE
  LOGO
  VIDEO_PLACEHOLDER
}

enum PromotionReportReason {
  MISLEADING
  INAPPROPRIATE
  SCAM
  PROHIBITED
  IRRELEVANT
  OTHER
}

enum PromotionReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponScope {
  PLATFORM
  VENDOR
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

/// A scheduled container grouping promotions/coupons with an activation window.
model Campaign {
  id          String         @id @default(cuid())
  ownerUserId String
  owner       User           @relation("CampaignOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        CampaignType   @default(FEATURED)
  status      CampaignStatus @default(DRAFT)
  timezone    String         @default("America/Belize")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  schedules     CampaignSchedule[]
  statusHistory CampaignStatusHistory[]
  promotions    Promotion[]
  coupons       Coupon[]

  @@index([ownerUserId, status])
  @@index([status])
  @@map("campaigns")
}

/// One activation window for a campaign (a campaign may have several, e.g. seasonal).
model CampaignSchedule {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  startAt    DateTime
  endAt      DateTime
  timezone   String   @default("America/Belize")
  createdAt  DateTime @default(now())

  @@index([campaignId])
  @@index([startAt, endAt])
  @@map("campaign_schedules")
}

model CampaignStatusHistory {
  id         String          @id @default(cuid())
  campaignId String
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fromStatus CampaignStatus?
  toStatus   CampaignStatus
  actorId    String?
  note       String?
  createdAt  DateTime        @default(now())

  @@index([campaignId])
  @@map("campaign_status_history")
}

/// A single promotional unit (featured item, banner, hero) with placements,
/// assets, targets, and daily metrics. Moderated before it can go public.
model Promotion {
  id               String          @id @default(cuid())
  ownerUserId      String
  owner            User            @relation("PromotionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  type             PromotionType
  title            String
  subtitle         String?
  description      String?
  status           PromotionStatus @default(DRAFT)
  priority         Int             @default(0)
  isActive         Boolean         @default(false)
  startAt          DateTime?
  endAt            DateTime?
  timezone         String          @default("America/Belize")
  moderationReason String?
  moderatedById    String?
  moderatedBy      User?           @relation("PromotionModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  submittedAt      DateTime?
  approvedAt       DateTime?
  publishedAt      DateTime?
  expiredAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  placements  PromotionPlacement[]
  assets      PromotionAsset[]
  targets     PromotionTarget[]
  metrics     PromotionMetricDaily[]
  redemptions PromotionRedemption[]
  reports     PromotionReport[]

  @@index([status])
  @@index([ownerUserId, status])
  @@index([type, status])
  @@index([campaignId])
  @@map("promotions")
}

/// Where a promotion renders. `placement` is an enum + optional context FK
/// (categoryId) so placements are never hardcoded.
/// Device visibility for an admin-controlled ad placement.
enum PromotionDevice {
  BOTH
  DESKTOP
  MOBILE
}

/// Where an approved promotion appears. Placement is Admin-controlled (assignedById):
/// a campaign exists without appearing anywhere until Admin assigns a placement, and
/// placement has its OWN eligibility (isActive + start/end window + device) that must
/// pass IN ADDITION TO the campaign/promotion eligibility before an ad renders.
model PromotionPlacement {
  id           String                 @id @default(cuid())
  promotionId  String
  promotion    Promotion              @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  placement    PromotionPlacementType
  position     Int                    @default(0)
  categoryId   String?
  category     Category?              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Admin placement controls (separate from campaign content).
  isActive     Boolean                @default(true)
  device       PromotionDevice        @default(BOTH)
  startAt      DateTime?
  endAt        DateTime?
  assignedById String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([promotionId, placement, categoryId])
  @@index([placement])
  @@index([categoryId])
  @@map("promotion_placements")
}

/// Public media for a promotion. Desktop/mobile/hero/square/logo/video variants
/// are distinguished by an explicit `kind`, not inferred.
model PromotionAsset {
  id            String             @id @default(cuid())
  promotionId   String
  promotion     Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  kind          PromotionAssetKind
  storageKey    String?            @unique
  mimeType      String?
  fileSizeBytes Int?
  width         Int?
  height        Int?
  altText       String?
  videoUrl      String?
  position      Int                @default(0)
  createdAt     DateTime           @default(now())

  @@index([promotionId, position])
  @@map("promotion_assets")
}

/// What a promotion features. Polymorphic via typed nullable FKs (no JSON).
/// Exactly one target FK is set per row, selected by `targetType`.
model PromotionTarget {
  id                     String                  @id @default(cuid())
  promotionId            String
  promotion              Promotion               @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  targetType             PromotionTargetType
  vendorProfileId        String?
  vendorProfile          VendorProfile?          @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  employerProfileId      String?
  employerProfile        EmployerProfile?        @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  agencyProfileId        String?
  agencyProfile          AgencyProfile?          @relation(fields: [agencyProfileId], references: [id], onDelete: Cascade)
  agentProfileId         String?
  agentProfile           RealEstateAgentProfile? @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  propertyOwnerProfileId String?
  propertyOwnerProfile   PropertyOwnerProfile?   @relation(fields: [propertyOwnerProfileId], references: [id], onDelete: Cascade)
  productId              String?
  product                Product?                @relation(fields: [productId], references: [id], onDelete: Cascade)
  jobListingId           String?
  jobListing             JobListing?             @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  propertyListingId      String?
  propertyListing        PropertyListing?        @relation(fields: [propertyListingId], references: [id], onDelete: Cascade)
  externalUrl            String?
  createdAt              DateTime                @default(now())

  @@index([promotionId])
  @@index([targetType])
  @@index([vendorProfileId])
  @@index([productId])
  @@index([jobListingId])
  @@index([propertyListingId])
  @@map("promotion_targets")
}

/// Normalized daily metric rollup per promotion (+ optional placement).
/// CTR/popularity are derived from these rows — never fabricated or stored raw.
model PromotionMetricDaily {
  id          String                  @id @default(cuid())
  promotionId String
  promotion   Promotion               @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  day         DateTime                @db.Date
  placement   PromotionPlacementType?
  impressions Int                     @default(0)
  views       Int                     @default(0)
  clicks      Int                     @default(0)
  conversions Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([promotionId, day, placement])
  @@index([promotionId, day])
  @@map("promotion_metrics_daily")
}

/// A recorded conversion/redemption event attributed to a promotion.
model PromotionRedemption {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation("PromotionRedeemer", fields: [userId], references: [id], onDelete: SetNull)
  orderId     String?
  redeemedAt  DateTime  @default(now())

  @@index([promotionId])
  @@index([userId])
  @@map("promotion_redemptions")
}

model PromotionReport {
  id             String                @id @default(cuid())
  promotionId    String
  promotion      Promotion             @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  reporterUserId String?
  reporter       User?                 @relation("PromotionReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reason         PromotionReportReason
  note           String?
  status         PromotionReportStatus @default(OPEN)
  resolvedById   String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime              @default(now())

  @@index([status])
  @@index([promotionId])
  @@map("promotion_reports")
}

/// Discount / coupon codes. Platform-wide (admin-owned) or vendor-scoped.
/// Money in BZD minor units; percentages are whole percents. Wallet checkout
/// integration is future work — no wallet/order coupling here.
model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  ownerUserId      String?
  owner            User?              @relation("CouponOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  vendorProfileId  String?
  vendorProfile    VendorProfile?     @relation("VendorCoupons", fields: [vendorProfileId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  scope            CouponScope        @default(PLATFORM)
  discountType     CouponDiscountType
  percentOff       Int?
  amountOffMinor   BigInt?
  freeShipping     Boolean            @default(false)
  minSpendMinor    BigInt?
  maxDiscountMinor BigInt?
  maxUses          Int?
  perUserLimit     Int?
  usedCount        Int                @default(0)
  stackable        Boolean            @default(false)
  status           CouponStatus       @default(INACTIVE)
  startAt          DateTime?
  endAt            DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  usages CouponUsage[]

  @@index([status])
  @@index([vendorProfileId])
  @@index([campaignId])
  @@map("coupons")
}

/// One coupon redemption; enforces maxUses (via count) and perUserLimit.
model CouponUsage {
  id                   String   @id @default(cuid())
  couponId             String
  coupon               Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId               String
  user                 User     @relation("CouponUser", fields: [userId], references: [id], onDelete: Cascade)
  orderId              String?
  discountAppliedMinor BigInt   @default(0)
  redeemedAt           DateTime @default(now())

  @@index([couponId, userId])
  @@index([userId])
  @@map("coupon_usages")
}

// ============================================================================
// MULTI-LEG LOGISTICS
//
// Local delivery — one vendor, one courier, one town — stays exactly where it
// is: VendorOrder → OrderDelivery, dispatched by the existing engine. Nothing
// below touches that path.
//
// These models sit ABOVE it, for the journeys a single courier cannot make:
// Placencia to San Pedro is a collection, a flight, and a delivery, with the
// parcel resting at two terminals in between. A Shipment is the plan; its legs
// are the steps. A courier leg IS an OrderDelivery (same engine, same drivers,
// same tested state machine) — the shipment only sequences them and records who
// is holding the parcel.
//
// The network is DATA. Adding a water taxi terminal, grounding a flight, or
// opening a new district is a row, never a deploy.
// ============================================================================

/// How a leg physically moves. Mirrors TRANSPORT_MODES in @bmpl/shared.
enum TransportMode {
  LAND
  AIR
  SEA
}

/// What kind of place a hub is. Broad on purpose: BMPL owns none of the
/// airports or water taxi terminals it hands parcels to.
enum HubType {
  AIRPORT
  AIRSTRIP
  WATER_TAXI_TERMINAL
  SEA_TERMINAL
  BUS_TERMINAL
  WAREHOUSE
  DISTRIBUTION_CENTER
  BMPL_HUB
}

/// Which ends BMPL is responsible for. "Door" means we collect from or deliver
/// to an address; "Hub" means the customer handles that end at a terminal.
enum ShippingService {
  DOOR_TO_DOOR
  DOOR_TO_HUB
  HUB_TO_DOOR
  HUB_TO_HUB
}

/// A leg's role in the journey.
enum LegKind {
  DIRECT
  FIRST_MILE
  LINE_HAUL
  LAST_MILE
}

enum LegStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXCEPTION
}

/// Derived from the legs by deriveShipmentStatus() in @bmpl/shared, never set
/// independently. Two writable sources for one fact is how they drift.
enum ShipmentStatus {
  DRAFT
  AWAITING_PICKUP
  FIRST_MILE
  AT_ORIGIN_HUB
  IN_TRANSIT
  AT_DESTINATION_HUB
  OUT_FOR_DELIVERY
  AWAITING_COLLECTION
  DELIVERED
  EXCEPTION
  CANCELLED
}

/// Who is holding the parcel right now.
enum CustodyHolder {
  SENDER
  DRIVER
  HUB
  CARRIER
  RECIPIENT
}

/// Somewhere a parcel can change hands.
///
/// `code` is the short handle operators actually say out loud ("SPW"), and it is
/// also the deterministic tie-break the route planner falls back on, so it must
/// be unique and stable.
model LogisticsHub {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  type            HubType
  district        District
  city            String
  addressLine1    String?
  addressLine2    String?
  latitude        Float?
  longitude       Float?
  /// Modes this hub can physically handle. An airstrip cannot take a boat, and
  /// the planner will not route one to it.
  modes           TransportMode[]
  /// What BMPL charges for a door leg at this hub - the courier run between this
  /// terminal and an address in its town. Owner-configured DATA, not a rule this
  /// code invented; 0 means "not set yet" and a quote says so out loud rather
  /// than quietly shipping for free.
  courierFeeMinor BigInt          @default(0)
  /// Shown to whoever is dropping off or collecting: which counter, what hours.
  instructions    String?
  contactName     String?
  contactPhone    String?
  /// Deactivating a hub removes it from planning without deleting the history of
  /// everything that ever moved through it.
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  routesFrom    LogisticsRoute[] @relation("RouteOrigin")
  routesTo      LogisticsRoute[] @relation("RouteDestination")
  legsFrom      ShipmentLeg[]    @relation("LegOriginHub")
  legsTo        ShipmentLeg[]    @relation("LegDestinationHub")
  shipmentsFrom Shipment[]       @relation("ShipmentOriginHub")
  shipmentsTo   Shipment[]       @relation("ShipmentDestinationHub")
  custodyEvents CustodyEvent[]

  // Attaching a door to a terminal is always "active hubs in this district".
  @@index([district, isActive])
  @@map("logistics_hubs")
}

/// A transport service someone actually runs between two hubs.
///
/// Deliberately NOT unique on (origin, destination, mode): two carriers may fly
/// the same pair, and operations should be able to configure both and let the
/// planner pick. Planning stays deterministic because ties break on route id.
model LogisticsRoute {
  id               String        @id @default(cuid())
  originHubId      String
  originHub        LogisticsHub  @relation("RouteOrigin", fields: [originHubId], references: [id], onDelete: Restrict)
  destinationHubId String
  destinationHub   LogisticsHub  @relation("RouteDestination", fields: [destinationHubId], references: [id], onDelete: Restrict)
  mode             TransportMode
  /// Who operates it. BMPL does not fly the planes.
  carrierName      String?
  carrierPhone     String?
  /// Scheduling is a label, not a calendar — operations write "Mon/Wed/Fri 09:00"
  /// and the planner only reports it. Real timetables are a later problem.
  scheduleNote     String?
  durationMinutes  Int
  /// The transport component of the quote, in minor units. Courier legs are
  /// priced by the existing delivery rules, not here.
  priceMinor       BigInt        @default(0)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  legs ShipmentLeg[]

  @@index([originHubId, isActive])
  @@index([destinationHubId, isActive])
  @@map("logistics_routes")
}

/// One parcel's journey, however many legs it takes.
///
/// Addresses are SNAPSHOTS. A shipment in flight must not change shape because
/// someone edited a saved address, and the driver on leg 3 must see what was
/// agreed at booking.
model Shipment {
  id        String          @id @default(cuid())
  /// Customer-facing tracking reference.
  reference String          @unique
  service   ShippingService
  /// Derived from the legs. Stored so it can be indexed and listed; recomputed
  /// on every leg transition rather than set by hand.
  status    ShipmentStatus  @default(DRAFT)
  /// Inherited from the order, which inherits it from the vendor. A test
  /// shipment can never be created by flipping a flag on a request.
  isTest    Boolean         @default(false)

  customerUserId String?
  customer       User?   @relation("ShipmentCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)

  /// Set when the shipment fulfils a marketplace order. Null for a standalone
  /// courier booking, which is why it is optional rather than the parent.
  vendorOrderId String?      @unique
  vendorOrder   VendorOrder? @relation("VendorOrderShipment", fields: [vendorOrderId], references: [id], onDelete: SetNull)

  // ---- Origin (snapshot) ----
  originHubId        String?
  originHub          LogisticsHub? @relation("ShipmentOriginHub", fields: [originHubId], references: [id], onDelete: Restrict)
  originName         String?
  originPhone        String?
  originEmail        String?
  originCompany      String?
  originAddress      String?
  originAddress2     String?
  originCity         String?
  originDistrict     District?
  originLatitude     Float?
  originLongitude    Float?
  originInstructions String?

  // ---- Destination (snapshot) ----
  destinationHubId        String?
  destinationHub          LogisticsHub? @relation("ShipmentDestinationHub", fields: [destinationHubId], references: [id], onDelete: Restrict)
  destinationName         String?
  destinationPhone        String?
  destinationEmail        String?
  destinationCompany      String?
  destinationAddress      String?
  destinationAddress2     String?
  destinationCity         String?
  destinationDistrict     District?
  destinationLatitude     Float?
  destinationLongitude    Float?
  destinationInstructions String?

  // ---- The plan ----
  preferredMode    TransportMode?
  /// One price for the whole journey — the sum of every leg, quoted once.
  quotedTotalMinor BigInt         @default(0)
  quotedMinutes    Int?
  /// Plain-language account of the route the planner chose, kept so the same
  /// explanation shown at booking is still there at 3am when it goes wrong.
  planExplanation  String?

  // ---- The parcel ----
  description String?
  weightGrams Int?
  pieces      Int     @default(1)

  // ---- Outcomes ----
  bookedAt           DateTime?
  deliveredAt        DateTime?
  collectedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  exceptionAt        DateTime?
  exceptionReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  legs          ShipmentLeg[]
  custodyEvents CustodyEvent[]

  @@index([customerUserId, createdAt])
  @@index([status, isTest])
  @@map("shipments")
}

/// One step of a journey.
///
/// `sequence` is authority: nothing may start until every earlier live leg has
/// completed (isLegActionable in @bmpl/shared). That rule is what stops a
/// last-mile courier being dispatched to a terminal the parcel is still flying
/// towards.
model ShipmentLeg {
  id         String        @id @default(cuid())
  shipmentId String
  shipment   Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sequence   Int
  kind       LegKind
  mode       TransportMode
  status     LegStatus     @default(PENDING)

  originHubId      String?
  originHub        LogisticsHub?   @relation("LegOriginHub", fields: [originHubId], references: [id], onDelete: Restrict)
  destinationHubId String?
  destinationHub   LogisticsHub?   @relation("LegDestinationHub", fields: [destinationHubId], references: [id], onDelete: Restrict)
  routeId          String?
  route            LogisticsRoute? @relation(fields: [routeId], references: [id], onDelete: Restrict)

  /// A courier leg IS an ordinary delivery. The existing dispatch engine offers
  /// it, the existing driver app works it, the existing PIN verifies it. The
  /// shipment layer creates this row and then gets out of the way.
  orderDeliveryId String?        @unique
  orderDelivery   OrderDelivery? @relation("LegDelivery", fields: [orderDeliveryId], references: [id], onDelete: SetNull)

  // ---- Courier legs are worked by BMPL drivers ----
  //
  // A first- or last-mile leg is real driver work, so it carries the same
  // assignment shape a delivery does. `courierStatus` deliberately reuses the
  // proven DeliveryStatus vocabulary rather than inventing a parallel one: the
  // driver app's state machine, view mapping and next-action helpers then work
  // on a shipment leg without a single new branch. `status` above stays the
  // SHIPMENT's view of the leg; this is the DRIVER's view of the same thing.
  courierStatus           DeliveryStatus?
  assignedDriverProfileId String?
  assignedDriver          DriverProfile?  @relation("DriverShipmentLegs", fields: [assignedDriverProfileId], references: [id], onDelete: SetNull)
  assignedVehicleId       String?
  assignedVehicle         DriverVehicle?  @relation("VehicleShipmentLegs", fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  assignedAt              DateTime?
  acceptedAt              DateTime?
  declinedAt              DateTime?
  declineReason           String?
  pickedUpAt              DateTime?
  inTransitAt             DateTime?
  arrivingAt              DateTime?
  /// Rolling single offer, same as delivery dispatch: what the sweeper scans for,
  /// what stops it looping forever, and the point a human is genuinely needed.
  offerExpiresAt          DateTime?
  offerCount              Int             @default(0)
  dispatchExhaustedAt     DateTime?
  /// The driver's own ordering preference across all their work.
  driverQueuePosition     Int?

  /// A line-haul leg is operated by someone BMPL does not employ, so there is no
  /// driver to track — an operator confirms departure and arrival by hand.
  carrierName          String?
  carrierBookingRef    String?
  scheduledDepartureAt DateTime?
  scheduledArrivalAt   DateTime?
  departedAt           DateTime?
  arrivedAt            DateTime?

  durationMinutes Int     @default(0)
  priceMinor      BigInt  @default(0)
  /// The customer-facing sentence for this step, written by the planner.
  description     String?

  // ---- Handoff verification at the end of this leg ----
  // Same shape as the delivery PIN that already works: the receiver holds a code
  // the deliverer must produce. Access-controlled; never returned to the party
  // that has to submit it, and never logged.
  handoffPin                String?
  handoffPinAttempts        Int                @default(0)
  handoffVerifiedAt         DateTime?
  handoffVerificationStatus VerificationStatus @default(PENDING)
  handoffReceivedByName     String?
  handoffPhotoKeys          String[]

  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  exceptionAt     DateTime?
  exceptionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  custodyEvents CustodyEvent[]
  offers        ShipmentLegOffer[]

  // Sequence is unique per shipment — two legs numbered 3 would make "what is
  // next" ambiguous, and the sequencing rule depends on it being answerable.
  @@unique([shipmentId, sequence])
  @@index([shipmentId, sequence])
  @@index([status, kind])
  // The driver's feed and their queue ordering.
  @@index([assignedDriverProfileId, courierStatus])
  @@index([assignedDriverProfileId, driverQueuePosition])
  // What the offer sweeper asks every tick.
  @@index([offerExpiresAt])
  // Finding courier work to dispatch: legs whose turn has come and nobody holds.
  @@index([status, kind, courierStatus])
  @@map("shipment_legs")
}

/// Append-only offer history for a courier leg. The CURRENT offer is
/// denormalized onto the leg for fast reads; this is the record of everyone who
/// was ever asked, which is what stops the dispatcher offering the same leg to
/// the same driver twice and what answers "why did this take four hours".
model ShipmentLegOffer {
  id              String                   @id @default(cuid())
  shipmentLegId   String
  shipmentLeg     ShipmentLeg              @relation(fields: [shipmentLegId], references: [id], onDelete: Cascade)
  driverProfileId String
  driverProfile   DriverProfile            @relation("DriverShipmentLegOffers", fields: [driverProfileId], references: [id], onDelete: Restrict)
  vehicleId       String?
  vehicle         DriverVehicle?           @relation("VehicleShipmentLegOffers", fields: [vehicleId], references: [id], onDelete: SetNull)
  status          DeliveryAssignmentStatus @default(ACTIVE)
  assignedAt      DateTime                 @default(now())
  respondedAt     DateTime?
  endedAt         DateTime?
  declineReason   String?
  createdAt       DateTime                 @default(now())

  @@index([shipmentLegId, assignedAt])
  @@index([driverProfileId, status])
  @@map("shipment_leg_offers")
}

/// Append-only chain of custody. One row per transfer, never updated, never
/// deleted — the answer to "who had it when it went missing" is only worth
/// having if nothing can rewrite it.
model CustodyEvent {
  id            String       @id @default(cuid())
  shipmentId    String
  shipment      Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentLegId String?
  shipmentLeg   ShipmentLeg? @relation(fields: [shipmentLegId], references: [id], onDelete: SetNull)

  /// Null on the first event: nobody held it before the sender.
  fromHolder CustodyHolder?
  toHolder   CustodyHolder

  hubId String?
  hub   LogisticsHub? @relation(fields: [hubId], references: [id], onDelete: SetNull)

  /// Who recorded the transfer. Not every party has an account — a carrier's
  /// counter staff do not — so `actorLabel` carries the name when `actor` cannot.
  actorUserId String?
  actor       User?   @relation("CustodyActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorLabel  String?

  latitude  Float?
  longitude Float?

  verification VerificationStatus @default(PENDING)
  note         String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([shipmentId, occurredAt])
  @@index([shipmentLegId])
  @@map("custody_events")
}
