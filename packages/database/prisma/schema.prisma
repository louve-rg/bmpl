// ---- Reviews & Ratings (Phase 4 · M19) --------------------------------------
// Verified reviews tied to a COMPLETED transaction. subjectId is a plain indexed
// id (product / vendor-profile / driver-profile) — aggregates recompute by
// (subjectType, subjectId, status). The verified context (order item / vendor-order /
// delivery) makes each review non-duplicable per reviewer.

enum ReviewSubjectType {
  PRODUCT
  VENDOR
  DRIVER
}

// The order artifact that proves eligibility for a review.
enum ReviewContextType {
  ORDER_ITEM // product review
  VENDOR_ORDER // vendor review
  ORDER_DELIVERY // driver / delivery review
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN // hidden by moderation (kept, not deleted)
  REJECTED // prohibited content (kept for audit)
}

enum ReviewReportReason {
  SPAM
  HARASSMENT
  IRRELEVANT
  PROHIBITED
  PRIVACY
  FRAUDULENT
}

enum ReviewReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum ReviewMediaStatus {
  APPROVED
  REJECTED
}

enum WalletAccountType {
  USER
  SYSTEM_ESCROW
  SYSTEM_PLATFORM_FEES
  SYSTEM_TOPUP_CLEARING
  SYSTEM_PAYOUTS_CLEARING
}

enum WalletAccountStatus {
  ACTIVE
  LOCKED
  SUSPENDED
}

enum WalletTransactionType {
  TOPUP
  PAYMENT
  VENDOR_EARNING
  DRIVER_EARNING
  REFUND
  ESCROW_HOLD
  ESCROW_RELEASE
  PLATFORM_FEE
  TRANSFER
  WITHDRAWAL
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum Currency {
  BZD
  USD
}

// ---- Identity ---------------------------------------------------------------

model User {
  id                   String       @id @default(cuid())
  /// A simulation account. Admin-set only, exactly like VendorProfile.isTest and
  /// DriverProfile.isTest. It is what gates TEST wallet funding: a user cannot
  /// set this on themselves, so they cannot mint themselves money.
  isTest               Boolean      @default(false)
  email                String       @unique
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  district             District?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  // ---- Profile picture ----
  // avatarKey is the LIVE, approved picture; avatarPendingKey is a newer upload
  // still under review. Keeping them apart means a rejected replacement never
  // wipes the photo the user already had approved.
  avatarKey            String? // private storage key; served via /users/:id/avatar
  avatarPendingKey     String?
  avatarStatus         AvatarStatus @default(NONE)
  // Whether THIS approved picture passed identity review. Customer avatars are
  // cosmetic and auto-approved (false); provider avatars are verified (true).
  // Only a moderated picture is ever served publicly — recorded on the row rather
  // than re-derived from roles, so a picture approved as a driver's cannot become
  // public-by-accident, nor stay public if the role is later revoked.
  avatarModerated      Boolean      @default(false)
  avatarRejectedReason String?
  // Highest face-detection confidence (0–100) returned by the vision provider,
  // kept so an admin reviewing the queue can see why it was flagged.
  avatarFaceScore      Float?
  avatarSubmittedAt    DateTime?
  avatarReviewedAt     DateTime?
  avatarReviewedById   String?

  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  lastLoginAt     DateTime?
  acceptedTermsAt DateTime?

  // The user's currently active role in the switcher (must be an APPROVED UserRole).
  activeRoleCode RoleCode? @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                      UserRole[]
  sessions                   Session[]
  emailTokens                EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  roleApplications           RoleApplication[]
  adminPermissions           AdminPermissionGrant[]    @relation("PermissionHolder")
  grantedPermissions         AdminPermissionGrant[]    @relation("PermissionGrantedBy")
  notifications              NotificationRecipient[]
  notificationPreferences    NotificationPreference[]
  conversationsCreated       Conversation[]            @relation("ConversationCreatedBy")
  conversationParticipations ConversationParticipant[]
  messagesSent               Message[]                 @relation("MessageSender")
  messageReadReceipts        MessageReadReceipt[]
  auditLogsAsActor           AuditLog[]                @relation("AuditActor")
  auditLogsAsTarget          AuditLog[]                @relation("AuditTarget")
  reviewsPerformed           RoleApplicationReview[]   @relation("ReviewReviewer")
  reviewsWritten             Review[]                  @relation("ReviewAuthor")
  walletAccounts             WalletAccount[]
  cart                       Cart?
  orders                     Order[]
  payments                   Payment[]
  paymentMethods             PaymentMethod[]
  idempotencyKeys            IdempotencyKey[]
  vendorProfile              VendorProfile?            @relation("UserVendorProfile")
  driverProfile              DriverProfile?            @relation("UserDriverProfile")
  deliveriesAssigned         OrderDelivery[]           @relation("DeliveryAssignedBy")
  deliveryAssignmentsMade    DeliveryAssignment[]      @relation("AssignmentAssignedBy")
  vendorReviewsMade          VendorModerationReview[]  @relation("VendorReviewer")
  productReviewsMade         ProductModerationReview[] @relation("ProductReviewer")
  inventoryChangesMade       InventoryChange[]         @relation("InventoryActor")
  savedProducts              SavedProduct[]
  recentlyViewedProducts     RecentlyViewedProduct[]
  backInStockSubscriptions   BackInStockSubscription[]
  // Belize Connect / Jobs (Phase 5 · M24)
  jobSeekerProfile           JobSeekerProfile?         @relation("UserJobSeekerProfile")
  employerProfile            EmployerProfile?          @relation("UserEmployerProfile")
  jobApplications            JobApplication[]          @relation("ApplicantApplications")
  savedJobs                  SavedJob[]
  recentlyViewedJobs         RecentlyViewedJob[]
  // Real Estate (Phase 6 · M25)
  propertyOwnerProfile       PropertyOwnerProfile?     @relation("UserPropertyOwnerProfile")
  realEstateAgentProfile     RealEstateAgentProfile?   @relation("UserRealEstateAgentProfile")
  agencyProfile              AgencyProfile?            @relation("UserAgencyManager")
  savedProperties            SavedProperty[]
  recentlyViewedProperties   RecentlyViewedProperty[]
  propertyEnquiries          PropertyEnquiry[]         @relation("EnquirerEnquiries")
  propertyViewingRequests    PropertyViewingRequest[]  @relation("RequesterViewings")
  // Marketing & Business Promotion (Phase 6 · M26)
  campaignsOwned             Campaign[]                @relation("CampaignOwner")
  promotionsOwned            Promotion[]               @relation("PromotionOwner")
  promotionsModerated        Promotion[]               @relation("PromotionModerator")
  couponsOwned               Coupon[]                  @relation("CouponOwner")
  couponUsages               CouponUsage[]             @relation("CouponUser")
  promotionRedemptions       PromotionRedemption[]     @relation("PromotionRedeemer")
  promotionReportsMade       PromotionReport[]         @relation("PromotionReporter")
  // Profile-picture moderation (self-relation: the admin who decided this avatar).
  avatarReviewedBy           User?                     @relation("AvatarReviewer", fields: [avatarReviewedById], references: [id], onDelete: SetNull)
  avatarReviewsMade          User[]                    @relation("AvatarReviewer")
  shipments                  Shipment[]                @relation("ShipmentCustomer")
  custodyEventsRecorded      CustodyEvent[]            @relation("CustodyActor")

  @@index([status])
  @@index([district])
  // Drives the admin moderation queue (PENDING first, oldest submission first).
  @@index([avatarStatus, avatarSubmittedAt])
  @@map("users")
  savedAddresses SavedAddress[]
}

// Server-side, revocable session. Access token is a short-lived JWT; the refresh
// token's HASH is stored here and rotated on use. Deleting the row revokes access.
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  client           String    @default("web") // "web" | "admin" | "mobile"
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---- Roles ------------------------------------------------------------------

// Catalog of role definitions (seeded, one row per RoleCode).
model Role {
  code             RoleCode @id
  label            String
  description      String
  isAdminRole      Boolean  @default(false)
  requiresApproval Boolean  @default(true)
  autoGranted      Boolean  @default(false)
  createdAt        DateTime @default(now())

  userRoles UserRole[]

  @@map("roles")
}

// One row per (user, role). Each has its OWN status. This is the multi-role core.
model UserRole {
  id       String     @id @default(cuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleCode RoleCode
  role     Role       @relation(fields: [roleCode], references: [code])
  status   RoleStatus @default(PENDING)

  approvedAt   DateTime?
  suspendedAt  DateTime?
  revokedAt    DateTime?
  statusReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications RoleApplication[]

  @@unique([userId, roleCode])
  @@index([roleCode, status])
  @@map("user_roles")
}

// A request for a role. Documents + a chronological review trail hang off it.
model RoleApplication {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleCode   RoleCode
  userRoleId String?
  userRole   UserRole?             @relation(fields: [userRoleId], references: [id], onDelete: SetNull)
  status     RoleApplicationStatus @default(PENDING)
  message    String? // applicant's note

  submittedAt DateTime  @default(now())
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents RoleApplicationDocument[]
  reviews   RoleApplicationReview[]

  @@index([status])
  @@index([roleCode, status])
  @@index([userId])
  @@map("role_applications")
}

// A private uploaded document. `storageKey` is an opaque object-store key; the
// file is NEVER public and is served only through short-lived signed URLs.
model RoleApplicationDocument {
  id            String          @id @default(cuid())
  applicationId String
  application   RoleApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  label         String?
  storageKey    String          @unique
  contentType   String
  sizeBytes     Int
  uploadedAt    DateTime        @default(now())

  @@index([applicationId])
  @@map("role_application_documents")
}

// Immutable record of each decision/step taken on an application.
model RoleApplicationReview {
  id            String                 @id @default(cuid())
  applicationId String
  application   RoleApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  action        ReviewAction
  // Null when the actor is the applicant (SUBMITTED / INFO_PROVIDED).
  reviewerId    String?
  reviewer      User?                  @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  note          String?
  fromStatus    RoleApplicationStatus?
  toStatus      RoleApplicationStatus?
  createdAt     DateTime               @default(now())

  @@index([applicationId])
  @@map("role_application_reviews")
}

// ---- Admin permissions (separate from customer-facing roles) ----------------

model AdminPermissionGrant {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("PermissionHolder", fields: [userId], references: [id], onDelete: Cascade)
  permission  String // value from the shared PERMISSIONS catalog
  grantedById String?
  grantedBy   User?    @relation("PermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
  @@map("admin_permission_grants")
}

// ---- Notifications ----------------------------------------------------------

// A notification EVENT (M16). One event can fan out to many recipients (e.g. an
// admin alert to every admin holding a permission); per-user read/dismiss state
// lives on NotificationRecipient. `type` is the legacy top-level enum (back-compat);
// `category` is the module-aligned taxonomy; `event` is a stable machine key.
model Notification {
  id        String               @id @default(cuid())
  type      NotificationType
  category  NotificationCategory @default(SYSTEM)
  event     String? // stable machine key from @bmpl/shared NOTIFICATION_EVENTS
  title     String
  body      String
  data      Json? // structured payload (e.g. { orderId, deliveryId })
  createdAt DateTime             @default(now())

  recipients NotificationRecipient[]

  @@index([category, createdAt])
  @@map("notifications")
}

// Per-recipient delivery + read/dismiss state for a Notification event. Unique per
// (notification, user). Read = readAt set; dismissed = deletedAt set (soft delete).
model NotificationRecipient {
  id             String              @id @default(cuid())
  notificationId String
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        NotificationChannel @default(IN_APP)
  readAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@index([userId, deletedAt])
  @@index([notificationId])
  @@map("notification_recipients")
}

// Per-user, per-category delivery-channel preferences (M16). In-app is always
// stored; email/push are gated by these flags when those channels are wired.
model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  inApp     Boolean              @default(true)
  email     Boolean              @default(false)
  push      Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, category])
  @@index([userId])
  @@map("notification_preferences")
}

// ---- Messaging & Order Communication (Phase 4 · M17) ------------------------
// Scoped, context-bound conversations — NO arbitrary user-to-user chat. Every
// conversation is tied to a business context (a vendor-order, a delivery, or a
// support case). The (contextType, contextId, pairing) triple is unique so the
// same context + participant grouping is never duplicated. Driver SEND access is
// authorized dynamically against the delivery's CURRENT assigned driver, so a
// reassigned driver keeps read/history but loses send access automatically.

enum ConversationContext {
  ORDER
  VENDOR_ORDER
  DELIVERY
  SUPPORT_CASE
  JOB_APPLICATION
  PROPERTY_ENQUIRY
  /// One courier leg of a multi-leg shipment. Scoped to the LEG, not the
  /// shipment: a first-mile driver has no business in a conversation with the
  /// recipient at the far end of the country, and a last-mile driver has none
  /// with the sender.
  SHIPMENT_LEG
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum ConversationParticipantRole {
  CUSTOMER
  VENDOR
  DRIVER
  SUPPORT
  EMPLOYER
  APPLICANT
  LISTER
  ENQUIRER
}

enum MessageType {
  USER
  SYSTEM
  INTERNAL_NOTE // support/admin-only; never shown to end users
}

enum AttachmentScanStatus {
  PENDING
  CLEAN
  FLAGGED
}

model Conversation {
  id            String              @id @default(cuid())
  contextType   ConversationContext
  // Business id (vendorOrderId / deliveryId / generated support-case id). Used with
  // pairing to dedupe. Nullable only defensively; always set in practice.
  contextId     String
  // Canonical participant grouping (e.g. CUSTOMER_VENDOR, CUSTOMER_DRIVER,
  // VENDOR_DRIVER, USER_SUPPORT) — see @bmpl/shared CONVERSATION_PAIRINGS.
  pairing       String
  subject       String?
  status        ConversationStatus  @default(OPEN)
  createdById   String?
  createdBy     User?               @relation("ConversationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedById    String?
  closedAt      DateTime?
  lastMessageAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@unique([contextType, contextId, pairing])
  @@index([contextType, contextId])
  @@index([status, lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String                      @id @default(cuid())
  conversationId String
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationParticipantRole
  // Send access; DELIVERY driver access is ALSO checked dynamically at send time.
  canSend        Boolean                     @default(true)
  lastReadAt     DateTime?
  joinedAt       DateTime                    @default(now())
  leftAt         DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Null for SYSTEM messages.
  senderId       String?
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  type           MessageType  @default(USER)
  body           String
  editedAt       DateTime?
  deletedAt      DateTime? // soft delete; financial/support/safety messages are never hard-deleted
  createdAt      DateTime     @default(now())

  attachments  MessageAttachment[]
  readReceipts MessageReadReceipt[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id            String               @id @default(cuid())
  messageId     String
  message       Message              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey    String               @unique // private-bucket key
  mimeType      String
  fileSizeBytes Int
  fileName      String?
  scanStatus    AttachmentScanStatus @default(PENDING) // malware-scan placeholder
  createdAt     DateTime             @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_read_receipts")
}

// ---- Audit ------------------------------------------------------------------

model AuditLog {
  id            String      @id @default(cuid())
  action        AuditAction
  actorId       String?
  actor         User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId  String?
  targetUser    User?       @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetRole    RoleCode?
  previousValue Json?
  newValue      Json?
  reason        String?
  ipAddress     String?
  sessionId     String?
  createdAt     DateTime    @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---- Wallet (double-entry ledger foundation) --------------------------------

model WalletAccount {
  id                 String              @id @default(cuid())
  type               WalletAccountType
  // Null for SYSTEM_* accounts; set for USER accounts.
  userId             String?
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency           Currency            @default(BZD)
  // Operational state (M12) — authorization is rejected unless ACTIVE.
  status             WalletAccountStatus @default(ACTIVE)
  // Cached, DERIVED balance in minor units (cents). NOT the source of truth —
  // it is recomputed from ledger entries inside the same transaction that posts
  // them. Reconciliation always trusts the sum of WalletLedgerEntry rows.
  cachedBalanceMinor BigInt              @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  entries          WalletLedgerEntry[]
  walletHolds      WalletHold[]
  ledgerReferences LedgerReference[]

  // A user has at most one account per (type, currency); system accounts are unique per (type, currency).
  @@unique([userId, type, currency])
  @@index([type])
  @@map("wallet_accounts")
}

// A logical money movement. Its entries MUST sum to zero (enforced in app code
// and by the balanced-entries invariant in the wallet package).
model WalletTransaction {
  id          String                  @id @default(cuid())
  type        WalletTransactionType
  status      WalletTransactionStatus @default(PENDING)
  /// Rehearsal money. Inherited from the account owner at posting time, never
  /// passed in by a caller. Real financial reporting and settlement filter it
  /// out; the ledger still balances with it, because it is real double-entry
  /// bookkeeping over money that simply does not represent anything.
  isTest      Boolean                 @default(false)
  currency    Currency                @default(BZD)
  reference   String? // external/idempotency reference
  description String?
  metadata    Json?
  postedAt    DateTime?
  createdAt   DateTime                @default(now())

  entries WalletLedgerEntry[]

  @@unique([reference])
  @@index([type, status])
  @@index([isTest, createdAt])
  @@map("wallet_transactions")
}

model WalletLedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  // RESTRICT (not Cascade): a transaction with posted entries can never be
  // deleted, so ledger history cannot be silently removed by deleting its
  // parent transaction. Corrections are made by posting reversing entries.
  transaction   WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String
  account       WalletAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  direction     LedgerDirection
  // Always positive; direction determines sign. Minor units (cents).
  amountMinor   BigInt
  createdAt     DateTime          @default(now())

  @@index([accountId])
  @@index([transactionId])
  @@map("wallet_ledger_entries")
}

// ---- Marketplace: Categories (Phase 2 · M1) ---------------------------------
// Hierarchical, admin-managed catalog taxonomy. A product references the single
// most-specific Category (added in M4); the parent chain yields the full path.
// Self-referential parent/children with onDelete: Restrict so a category that
// still has children cannot be deleted out from under them.

model Category {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  description         String?
  // Icon is a short symbolic name (e.g. a lucide icon key) resolved by the UI.
  iconName            String?
  // Optional hero/thumbnail image stored as a PUBLIC-bucket storage key (never a URL).
  imageKey            String?
  featured            Boolean              @default(false)
  isVisible           Boolean              @default(true)
  sortOrder           Int                  @default(0)
  parentId            String?
  parent              Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            Category[]           @relation("CategoryHierarchy")
  products            Product[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  promotionPlacements PromotionPlacement[]

  @@index([parentId, sortOrder])
  @@index([isVisible])
  @@map("categories")
}

// ---- Marketplace: Vendors (Phase 2 · M2) ------------------------------------
// A VENDOR-role user builds ONE business profile. Approval is a separate axis
// from the VENDOR UserRole: the role grants the ability to build a storefront;
// the profile's own approvalStatus gates whether that storefront is public.
// Operational toggles live on VendorSettings so they can grow without touching
// the profile's identity/branding fields.

enum VendorApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum StoreStatus {
  OPEN
  CLOSED
}

enum ModerationAction {
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
  RESTORED
}

model VendorProfile {
  id              String               @id @default(cuid())
  // A simulation storefront. Admin-set only. Everything bought here becomes an
  // isTest order, which is what keeps the test flag unforgeable by a customer.
  isTest          Boolean              @default(false)
  userId          String               @unique
  user            User                 @relation("UserVendorProfile", fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  slug            String               @unique
  description     String?
  logoKey         String? // public-bucket storage key
  bannerKey       String? // public-bucket storage key
  contactEmail    String
  contactPhone    String?
  website         String?
  socialLinks     Json? // future-ready: { facebook?, instagram?, ... }
  approvalStatus  VendorApprovalStatus @default(DRAFT)
  storeStatus     StoreStatus          @default(CLOSED)
  rejectionReason String?
  ratingAverage   Float                @default(0) // placeholder; populated in a later phase
  ratingCount     Int                  @default(0) // placeholder
  submittedAt     DateTime?
  approvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  settings         VendorSettings?
  locations        VendorLocation[]
  openingHours     VendorOpeningHours[]
  reviews          VendorModerationReview[]
  products         Product[]
  cartItems        CartItem[]
  vendorOrders     VendorOrder[]
  deliveryZones    DeliveryZone[]
  deliveryEstimate DeliveryEstimate?
  settlements      VendorSettlement[]
  promotionTargets PromotionTarget[]
  coupons          Coupon[]                 @relation("VendorCoupons")

  @@index([approvalStatus])
  @@index([storeStatus])
  @@map("vendor_profiles")
}

model VendorSettings {
  id                         String        @id @default(cuid())
  vendorProfileId            String        @unique
  vendorProfile              VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  pickupEnabled              Boolean       @default(true)
  deliveryEnabled            Boolean       @default(false)
  vacationMode               Boolean       @default(false)
  minimumOrderMinor          BigInt? // Minimum delivery order (subtotal) to qualify for delivery
  deliveryRadiusKm           Int? // Maximum delivery radius (optional; informational in M13)
  // Delivery pricing (M13 foundation). Base flat fee applies when no zone matches
  // the destination district; a null base means "no flat rate" (a zone must match).
  baseDeliveryFeeMinor       BigInt?
  freeDeliveryThresholdMinor BigInt? // subtotal at/above which delivery is free
  taxesEnabled               Boolean       @default(false)
  autoAcceptOrders           Boolean       @default(false)
  // Out-of-stock visibility (M-usability). false (default) = keep OOS products/variants
  // visible with an "Out of Stock" badge + "Notify me" (Add to Cart disabled); true =
  // auto-hide OOS products/variants from the public marketplace until restocked.
  hideOutOfStock             Boolean       @default(false)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  @@map("vendor_settings")
}

// ---- Delivery & Shipping Foundation (Phase 4 · M13) -------------------------
// Vendors configure WHERE they deliver (zones = sets of districts), the FEE per
// zone (DeliveryRate), and an estimated delivery time (DeliveryEstimate). The
// pricing engine matches an order's destination district to a zone (else the
// vendor's base flat fee), applies the free-delivery threshold, and snapshots
// the result onto the order (OrderDelivery). NO delivery execution / dispatch /
// tracking / driver assignment — foundation data only.

// M13 introduced PENDING_ASSIGNMENT only. M15 (Dispatch & Delivery Execution)
// adds the full operational lifecycle. Transitions are enforced by the shared
// state machine (@bmpl/shared `DELIVERY_ACTIONS`).
enum DeliveryStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  DRIVER_ACCEPTED
  DRIVER_DECLINED
  PICKUP_CONFIRMED
  IN_TRANSIT
  ARRIVING
  DELIVERED
  CANCELLED
}

// Lifecycle of a single DeliveryAssignment attempt (history is append-only).
enum DeliveryAssignmentStatus {
  ACTIVE
  ACCEPTED
  DECLINED
  REASSIGNED
  CANCELLED
  COMPLETED
}

// Pickup / delivery PIN verification outcome.
enum VerificationStatus {
  PENDING
  VERIFIED
  OVERRIDDEN
  FAILED
}

model DeliveryZone {
  id              String        @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  name            String
  // Districts this zone covers. An enum array keeps zone→district membership on
  // the zone row (queryable with `has`), avoiding a separate join table while a
  // district maps to at most one active zone per vendor (enforced in the service).
  districts       District[]
  isActive        Boolean       @default(true)
  position        Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rate DeliveryRate?

  @@index([vendorProfileId])
  @@map("delivery_zones")
}

model DeliveryRate {
  id        String       @id @default(cuid())
  zoneId    String       @unique
  zone      DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  feeMinor  BigInt // delivery fee (minor units) for this zone
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("delivery_rates")
}

model DeliveryEstimate {
  id              String        @id @default(cuid())
  vendorProfileId String        @unique
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  minHours        Int // estimated minimum delivery time, in hours
  maxHours        Int // estimated maximum delivery time, in hours
  label           String? // optional human label, e.g. "1–3 business days"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("delivery_estimates")
}

model VendorLocation {
  id                 String        @id @default(cuid())
  vendorProfileId    String
  vendorProfile      VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  label              String
  addressLine1       String
  addressLine2       String?
  city               String
  district           District
  country            String        @default("BZ")
  // The pickup pin. Already existed and was never populated; the vendor can now
  // drop it on a map, and it becomes the authoritative point a driver navigates
  // to for collection. Same coordinate abstraction the customer's pin uses — no
  // second geographic system.
  latitude           Float?
  longitude          Float?
  // "Loading bay round the back", "ask at the pharmacy counter". Shown to the
  // driver once they have accepted, alongside the address.
  pickupInstructions String?
  isPrimary          Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([vendorProfileId])
  @@map("vendor_locations")
}

model VendorOpeningHours {
  id              String        @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  dayOfWeek       Int // 0=Sunday .. 6=Saturday
  openTime        String? // "HH:MM"
  closeTime       String? // "HH:MM"
  isClosed        Boolean       @default(false)

  @@unique([vendorProfileId, dayOfWeek])
  @@map("vendor_opening_hours")
}

model VendorModerationReview {
  id              String                @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile         @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  reviewerId      String?
  reviewer        User?                 @relation("VendorReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  action          ModerationAction
  note            String?
  fromStatus      VendorApprovalStatus?
  toStatus        VendorApprovalStatus?
  createdAt       DateTime              @default(now())

  @@index([vendorProfileId])
  @@map("vendor_moderation_reviews")
}

// ---- Marketplace: Products (Phase 2 · M4) -----------------------------------
// Product CORE: identity, categorization (single most-specific categoryId; the
// category parent-chain yields category/subcategory), pricing (minor units),
// SEO, physical dimensions, and the moderation lifecycle. Images (M5) and
// inventory + normalized variants (M6) attach to Product in later milestones.

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
  ARCHIVED
}

model Product {
  id              String                   @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile            @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title           String
  slug            String                   @unique
  description     String?
  sku             String
  barcode         String?
  brand           String?
  status          ProductStatus            @default(DRAFT)
  priceMinor      BigInt // minor units (cents), BZD
  salePriceMinor  BigInt?
  currency        Currency                 @default(BZD)
  weightGrams     Int?
  lengthMm        Int?
  widthMm         Int?
  heightMm        Int?
  featured        Boolean                  @default(false)
  metaTitle       String?
  metaDescription String?
  searchKeywords  String[] // used by the M7 Postgres search
  // Generated tsvector (title/brand/description/keywords) for full-text search.
  // Managed by raw SQL in the migration (GENERATED ALWAYS ... STORED) + GIN index;
  // declared Unsupported so Prisma tracks the column without managing generation.
  searchVector    Unsupported("tsvector")?
  ratingAverage   Float                    @default(0) // placeholder
  ratingCount     Int                      @default(0) // placeholder
  publishedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  tags             Tag[]                     @relation("ProductTags")
  reviews          ProductModerationReview[]
  images           ProductImage[]
  options          ProductOption[]
  variants         ProductVariant[]
  inventory        Inventory[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  backInStockSubs  BackInStockSubscription[]
  savedBy          SavedProduct[]
  recentlyViewedBy RecentlyViewedProduct[]
  promotionTargets PromotionTarget[]

  @@unique([vendorProfileId, sku])
  // Composite serves both the status filter and the default "newest published"
  // catalog sort (also covers status-only lookups via the leading column).
  @@index([status, createdAt])
  @@index([categoryId])
  @@index([vendorProfileId, status])
  @@index([featured])
  @@map("products")
}

// Product image metadata. The binary lives in the PUBLIC object-storage bucket;
// only the opaque storage key is persisted (never a URL). Exactly one image per
// product is primary — enforced transactionally in the service layer.
model ProductImage {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Optional association to a specific variant. null = general product image
  // (default gallery). SetNull on variant delete keeps the image as a general
  // product image (no data loss).
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  storageKey    String          @unique
  mimeType      String
  fileSizeBytes Int
  width         Int?
  height        Int?
  altText       String?
  caption       String?
  position      Int             @default(0)
  isPrimary     Boolean         @default(false)
  // Explicit BRAND-IMAGE role (M6.2). At most one per product. Used for marketplace
  // listing cards / search / category / storefront grid — NEVER shown in the product
  // detail gallery or a variant thumbnail row, and never variant-scoped. Kept as a
  // distinct field (not inferred from isPrimary) so listing vs gallery vs variant
  // roles are unambiguous.
  isBrandImage  Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@index([productId, position])
  // Serves the batched primary-image lookup on every catalog/listing page.
  @@index([productId, isPrimary])
  @@index([productId, isBrandImage])
  @@index([variantId])
  @@map("product_images")
}

// ---- Marketplace: Variants & Inventory (Phase 2 · M6) -----------------------
// Fully NORMALIZED variants (no JSON): a product has Options (e.g. "Size"), each
// with Values (e.g. "S","M"); a Variant is a concrete combination linked to one
// Value per option via VariantOptionValue. Inventory attaches either to a Variant
// or, when a product has no variants, to the Product itself (variantId = null).

enum InventoryChangeReason {
  INITIAL
  MANUAL
  RESTOCK
  CORRECTION
  RESERVE
  RELEASE
  BACKORDER
  // Reservation finalized into a real stock deduction at pickup confirmation (M15).
  FULFILLED
}

model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  values    ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id              String               @id @default(cuid())
  productOptionId String
  option          ProductOption        @relation(fields: [productOptionId], references: [id], onDelete: Cascade)
  value           String
  position        Int                  @default(0)
  variantLinks    VariantOptionValue[]

  @@unique([productOptionId, value])
  @@index([productOptionId])
  @@map("product_option_values")
}

model ProductVariant {
  id              String                    @id @default(cuid())
  productId       String
  product         Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String?
  barcode         String?
  // First-class, variant-specific marketplace display name (M6.1). Independent of
  // the base product title and the option-value labels. Title precedence is
  // displayName → option-value label join → base product title (never overwritten
  // by publication, image edits, price/inventory changes, or re-serialization).
  displayName     String?
  priceMinor      BigInt? // null = inherit the product price
  salePriceMinor  BigInt?
  position        Int                       @default(0)
  isActive        Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  optionValues    VariantOptionValue[]
  inventory       Inventory?
  images          ProductImage[]
  cartItems       CartItem[]
  backInStockSubs BackInStockSubscription[]
  savedProducts   SavedProduct[]
  orderItems      OrderItem[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

model VariantOptionValue {
  id                   String             @id @default(cuid())
  variantId            String
  variant              ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productOptionValueId String
  optionValue          ProductOptionValue @relation(fields: [productOptionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, productOptionValueId])
  @@index([productOptionValueId])
  @@map("variant_option_values")
}

model Inventory {
  id                String            @id @default(cuid())
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?           @unique
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int               @default(0) // on-hand
  reserved          Int               @default(0) // allocated (Phase 3 orders); available = quantity - reserved
  lowStockThreshold Int               @default(0)
  unlimited         Boolean           @default(false)
  allowBackorders   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  changes           InventoryChange[]

  // A product-level row has variantId = null; a partial unique index in the
  // migration enforces at most ONE such row per product. Variant rows are unique
  // via variantId @unique above.
  @@index([productId])
  @@map("inventory")
}

model InventoryChange {
  id          String                @id @default(cuid())
  inventoryId String
  inventory   Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  delta       Int // signed change to on-hand quantity
  reason      InventoryChangeReason
  previousQty Int
  newQty      Int
  actorId     String?
  actor       User?                 @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime              @default(now())

  @@index([inventoryId, createdAt])
  @@map("inventory_changes")
}

model Tag {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[] @relation("ProductTags")

  @@map("tags")
}

model ProductModerationReview {
  id         String           @id @default(cuid())
  productId  String
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   User?            @relation("ProductReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  action     ModerationAction
  note       String?
  fromStatus ProductStatus?
  toStatus   ProductStatus?
  createdAt  DateTime         @default(now())

  @@index([productId])
  @@map("product_moderation_reviews")
}

// ---- Marketplace: Shopping Cart (Phase 3 · M9) ------------------------------
// One ACTIVE server-side cart per customer (userId is unique). The cart is pure
// customer self-service — no admin approval or moderation is involved. A line
// item references EITHER a product (variantId = null) or a specific variant.
//
// Pricing: the server is the source of truth. `unitPriceMinorSnapshot` is the
// effective unit price captured when the line was last added/updated and is used
// only to detect a price change; the CURRENT price is always recomputed from the
// live product/variant on every read and change.
//
// Inventory is NOT reserved when an item is added to the cart — availability is
// merely validated. Reservation happens later at checkout/order creation (M10+).
//
// Multi-vendor: `vendorProfileId` is denormalized onto each item so the cart can
// be returned grouped by vendor and later split into one order per vendor.

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  Currency @default(BZD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                     String          @id @default(cuid())
  cartId                 String
  cart                   Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId              String
  product                Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Null for a product-level purchasable; set for a specific variant.
  variantId              String?
  variant                ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // Denormalized owner: enables vendor-grouped retrieval and the future per-vendor
  // order split without re-joining through product on every read.
  vendorProfileId        String
  vendorProfile          VendorProfile   @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  quantity               Int
  // Effective unit price (minor units) at the time the line was last written.
  // Display/price-change detection only — never trusted as the charge price.
  unitPriceMinorSnapshot BigInt
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Variant lines are unique per (cart, variant). Product-level lines (variantId
  // NULL) are made unique per (cart, product) by a PARTIAL unique index added in
  // the migration (Postgres treats NULLs as distinct, so the composite unique
  // below only constrains non-null variant rows).
  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([vendorProfileId])
  @@map("cart_items")
}

// ---- Marketplace: Orders & checkout (Phase 3 · M10) -------------------------
// Checkout converts a validated cart into a normalized order graph inside ONE
// transaction: a parent Order, one VendorOrder per storefront (the multi-vendor
// split), immutable OrderItem snapshots, and a snapshotted OrderAddress. Prices
// are recomputed server-side and SNAPSHOTTED (never trusted from the client).
// Inventory is RESERVED here (InventoryService.reserve) for the first time, in
// the same transaction, so a validation failure rolls back reservations too.
//
// M10 introduces only the INITIAL states (PENDING). Payment, fulfilment, refund,
// return, shipment-tracking, and wallet-transaction records are LATER milestones;
// the relational shape (parent → vendor orders → items) future-proofs them
// without JSON blobs. `VendorOrder.shippingMetadata` is a reserved placeholder.

enum OrderStatus {
  PENDING
  CANCELLED
}

enum VendorOrderStatus {
  PENDING
  // Vendor has started putting the order together (M26.3). Distinct from PENDING
  // so the customer timeline can say "preparing" instead of leaving a delivery
  // order visibly idle between payment and a driver appearing.
  PREPARING
  // Pickup fulfilment (M18.1). READY_FOR_PICKUP = vendor prepared it; PICKED_UP =
  // collection confirmed (the pickup analogue of a delivery reaching DELIVERED).
  // Reused unchanged for DELIVERY orders, where "ready for pickup" means ready
  // for the DRIVER to collect — the same physical fact, so it needs no new state.
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum OrderAddressType {
  SHIPPING
}

model Order {
  id                     String      @id @default(cuid())
  orderNumber            String      @unique
  // Simulation order (M26.3). NEVER accepted from client input — checkout derives
  // it from the vendor being bought from, so an ordinary customer buying from a
  // real store cannot produce one. Excluded from analytics, and its delivery may
  // only be offered to a driver profile that is itself flagged isTest.
  isTest                 Boolean     @default(false)
  userId                 String
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                 OrderStatus @default(PENDING)
  currency               Currency    @default(BZD)
  itemCount              Int // total quantity across all vendor orders
  subtotalMinor          BigInt
  // Aggregate delivery fee across delivery vendor-orders (M13). 0 for all-pickup
  // orders. totalMinor == subtotalMinor + deliveryFeeMinor (no tax/discounts yet).
  deliveryFeeMinor       BigInt      @default(0)
  totalMinor             BigInt
  // Operational (M10.1): set when this order's inventory reservations have been
  // released (admin utility / maintenance). Guards against double-release. This
  // is NOT customer cancellation and does not change the order's status.
  reservationsReleasedAt DateTime?
  placedAt               DateTime    @default(now())
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  vendorOrders VendorOrder[]
  addresses    OrderAddress[]
  payment      Payment?

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model VendorOrder {
  id                   String            @id @default(cuid())
  orderNumber          String            @unique // parent number + vendor suffix
  orderId              String
  order                Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorProfileId      String
  // Restrict: a storefront with orders cannot be hard-deleted (protects history).
  vendorProfile        VendorProfile     @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  status               VendorOrderStatus @default(PENDING)
  deliveryMethod       DeliveryMethod
  customerNotes        String?
  // Reserved for future shipment/tracking metadata — NOT used for order items.
  shippingMetadata     Json?
  currency             Currency          @default(BZD)
  itemCount            Int
  subtotalMinor        BigInt
  // Pickup fulfilment (M18.1). PIN held by the customer, submitted by the vendor at
  // collection (mirrors delivery). inventoryFinalizedAt guards exactly-once stock
  // deduction on collection.
  // When the vendor started assembling the order. A real column rather than
  // reusing updatedAt, which moves on any write and would misdate the customer's
  // timeline the moment anything else touched the row.
  preparingAt          DateTime?
  readyForPickupAt     DateTime?
  pickedUpAt           DateTime?
  pickupPin            String?
  pickupPinAttempts    Int               @default(0)
  inventoryFinalizedAt DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  items      OrderItem[]
  delivery   OrderDelivery?
  settlement VendorSettlement?
  // Set only when this order travels as a multi-leg shipment. A local delivery
  // has none, and nothing about it changes.
  shipment   Shipment?         @relation("VendorOrderShipment")

  @@index([orderId])
  @@index([vendorProfileId, createdAt])
  @@index([status])
  @@map("vendor_orders")
}

// Per-delivery-vendor-order snapshot (M13). Created only when a vendor-order's
// deliveryMethod is DELIVERY. The delivery address snapshot is the order-level
// OrderAddress (type SHIPPING) — not duplicated here. Status is PENDING_ASSIGNMENT
// only; later statuses/assignment/dispatch are out of scope for M13.
// The delivery record for a DELIVERY vendor-order. M13 created it (pricing snapshot,
// PENDING_ASSIGNMENT). M15 adds the operational lifecycle: the CURRENT assignment is
// denormalized here for fast reads (full history lives in DeliveryAssignment), plus
// per-transition timestamps, pickup/delivery PIN verification, proof-of-delivery, and
// an exactly-once inventory-finalization guard.
model OrderDelivery {
  id               String         @id @default(cuid())
  vendorOrderId    String         @unique
  vendorOrder      VendorOrder    @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  status           DeliveryStatus @default(PENDING_ASSIGNMENT)
  feeMinor         BigInt         @default(0)
  freeApplied      Boolean        @default(false) // free-delivery threshold met
  estimateMinHours Int?
  estimateMaxHours Int?
  estimateLabel    String?
  instructions     String?
  appliedZoneId    String? // which DeliveryZone priced this (null = base flat fee)

  // ---- Current assignment (denormalized; DeliveryAssignment holds full history) ----
  assignedDriverProfileId String?
  assignedDriver          DriverProfile? @relation("DriverActiveDeliveries", fields: [assignedDriverProfileId], references: [id], onDelete: SetNull)
  assignedVehicleId       String?
  assignedVehicle         DriverVehicle? @relation("VehicleActiveDeliveries", fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  assignedByUserId        String?
  assignedBy              User?          @relation("DeliveryAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  // ---- Lifecycle timestamps (append-only in spirit; set once per transition) ----
  assignedAt        DateTime?
  acceptedAt        DateTime?
  declinedAt        DateTime?
  pickupConfirmedAt DateTime?
  inTransitAt       DateTime?
  arrivingAt        DateTime?
  deliveredAt       DateTime?
  reassignedAt      DateTime?
  cancelledAt       DateTime?

  declineReason      String?
  reassignmentReason String?
  cancellationReason String?
  deliveryNotes      String?

  // ---- Automatic dispatch (M26.3) ----
  // The engine offers a delivery to one driver at a time and rolls forward when
  // the offer lapses. `offerExpiresAt` is what the sweeper scans for, `offerCount`
  // is what stops it looping forever, and `dispatchExhaustedAt` marks the point a
  // human genuinely is needed — the one case an admin should still see.
  offerExpiresAt      DateTime?
  offerCount          Int       @default(0)
  dispatchExhaustedAt DateTime?
  // Set once the vendor marks the order ready; dispatch never offers a delivery
  // for goods that are not yet packed, or a driver arrives to wait at a counter.
  readyForDispatchAt  DateTime?

  // ---- The driver's own queue ordering (M26.3 client feedback) ----
  // A preference, not a lifecycle field. It says which job the driver intends to
  // do next and is read by nothing except the queue view. Null = no preference,
  // fall back to the computed route recommendation.
  driverQueuePosition Int?

  // ---- Pickup verification (driver submits a PIN the vendor holds) ----
  pickupPin                String? // access-controlled; never returned to driver/public/logs
  pickupPinAttempts        Int                @default(0)
  pickupVerifiedAt         DateTime?
  pickupVerificationStatus VerificationStatus @default(PENDING)

  // ---- Delivery verification (driver submits a PIN the recipient holds) ----
  deliveryPin                String? // access-controlled; never returned to driver/public/logs
  deliveryPinAttempts        Int                @default(0)
  deliveryVerifiedAt         DateTime?
  deliveryVerificationStatus VerificationStatus @default(PENDING)
  recipientName              String?
  podPhotoKeys               String[] // private-bucket proof-of-delivery photo keys
  signatureKey               String? // reserved placeholder (private); no capture UI in M15

  // Exactly-once guard: reservation → stock deduction happens at PICKUP_CONFIRMED.
  inventoryFinalizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments   DeliveryAssignment[]
  timeline      DeliveryTimelineEvent[]
  driverEarning DriverEarning?
  // Set when this delivery is one leg of a longer journey. Null for every
  // ordinary local delivery, which is the overwhelming majority.
  shipmentLeg   ShipmentLeg?            @relation("LegDelivery")

  @@index([status])
  @@index([assignedDriverProfileId, status])
  // "My open deliveries, in my order" — covers the queue read's sort.
  @@index([assignedDriverProfileId, driverQueuePosition])
  // The dispatch sweeper runs on an interval and asks exactly one question:
  // which offers have lapsed? Without this it is a full scan of every delivery
  // ever made, every tick, forever.
  @@index([offerExpiresAt])
  // Finding work to dispatch: deliveries the vendor has readied but nobody holds.
  @@index([status, readyForDispatchAt])
  @@map("order_deliveries")
}

// Append-only assignment history. One row per assignment attempt; the current row
// is denormalized onto OrderDelivery. Reassignment ends the ACTIVE row (REASSIGNED)
// and creates a new ACTIVE row — historical rows are never overwritten or deleted.
model DeliveryAssignment {
  id               String                   @id @default(cuid())
  orderDeliveryId  String
  orderDelivery    OrderDelivery            @relation(fields: [orderDeliveryId], references: [id], onDelete: Cascade)
  driverProfileId  String
  driverProfile    DriverProfile            @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)
  vehicleId        String?
  vehicle          DriverVehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  assignedByUserId String?
  assignedBy       User?                    @relation("AssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  status           DeliveryAssignmentStatus @default(ACTIVE)
  assignedAt       DateTime                 @default(now())
  respondedAt      DateTime? // accept/decline time
  endedAt          DateTime? // reassigned/cancelled/completed time
  declineReason    String?
  endReason        String? // reassignment / cancellation reason that ended this row
  createdAt        DateTime                 @default(now())

  @@index([orderDeliveryId, assignedAt])
  @@index([driverProfileId, status])
  @@map("delivery_assignments")
}

// Append-only delivery timeline. One row per state transition (and PIN/POD events),
// used to render the customer/admin timeline. Never mutated.
model DeliveryTimelineEvent {
  id              String          @id @default(cuid())
  orderDeliveryId String
  orderDelivery   OrderDelivery   @relation(fields: [orderDeliveryId], references: [id], onDelete: Cascade)
  fromStatus      DeliveryStatus?
  toStatus        DeliveryStatus?
  event           String // action key (e.g. ASSIGN, ACCEPT, CONFIRM_PICKUP, POD_UPLOADED)
  actorRole       String // ADMIN | DRIVER | CUSTOMER | VENDOR | SYSTEM
  actorUserId     String?
  note            String?
  createdAt       DateTime        @default(now())

  @@index([orderDeliveryId, createdAt])
  @@map("delivery_timeline_events")
}

// ---- Logistics: Driver Management Foundation (Phase 4 · M14) ----------------
// Approved delivery-driver accounts. The driver ROLE (DELIVERY_DRIVER) + its
// documents + approval workflow reuse the existing role-application system; the
// role's UserRole status is the source of truth for approval/suspend/revoke.
// These models hold the driver's operational profile, vehicles, and service
// areas. NO assignment/dispatch/tracking/earnings/wallets in M14.

enum DriverAvailability {
  OFFLINE
  ONLINE
  UNAVAILABLE
  SUSPENDED
}

enum VehicleType {
  CAR
  MOTORCYCLE
  SCOOTER
  BICYCLE
  VAN
  TRUCK
  OTHER
}

enum VehicleOwnership {
  OWNED
  LEASED
  BORROWED
  NONE
}

enum VehicleApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model DriverProfile {
  id                    String             @id @default(cuid())
  // A designated simulation driver. Admin-set only. Test deliveries are offered
  // ONLY to these, and these are offered ONLY test deliveries — the isolation is
  // symmetric so a rehearsal can never touch a real customer, and a real order
  // can never land on a test account. Enforced in DriverService, which every
  // assignment path already goes through.
  isTest                Boolean            @default(false)
  userId                String             @unique
  user                  User               @relation("UserDriverProfile", fields: [userId], references: [id], onDelete: Cascade)
  // Application / identity data (captured with the driver-role application).
  legalName             String
  displayName           String
  phone                 String
  homeDistrict          District
  homeAddress           String?
  latitude              Float?
  longitude             Float?
  emergencyContactName  String?
  emergencyContactPhone String?
  licenceNumber         String
  licenceExpiry         DateTime
  vehicleOwnership      VehicleOwnership   @default(OWNED)
  termsAcceptedAt       DateTime?
  applicantNotes        String?
  profilePhotoKey       String? // private-bucket storage key
  // Operational.
  availability          DriverAvailability @default(OFFLINE)
  isActive              Boolean            @default(true)
  // Placeholders — populated in a later phase; NO money movement in M14.
  ratingAverage         Float              @default(0)
  ratingCount           Int                @default(0)
  completedDeliveries   Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  vehicles            DriverVehicle[]
  serviceAreas        DriverServiceArea[]
  // Dispatch (M15): the current deliveries assigned to this driver + full history.
  activeDeliveries    OrderDelivery[]      @relation("DriverActiveDeliveries")
  activeShipmentLegs  ShipmentLeg[]        @relation("DriverShipmentLegs")
  shipmentLegOffers   ShipmentLegOffer[]   @relation("DriverShipmentLegOffers")
  deliveryAssignments DeliveryAssignment[]
  driverEarnings      DriverEarning[]

  @@index([availability])
  @@map("driver_profiles")
}

// ---- Settlement & Earnings (Phase 3 · M18) ----------------------------------
// After a VendorOrder's fulfilment completes, escrow is distributed INTERNALLY:
// vendor net → vendor USER wallet, driver earning → driver USER wallet, platform
// fees → SYSTEM_PLATFORM_FEES. No external withdrawal/bank payout. Every posting
// is a single balanced WalletTransaction via the ONE approved WalletService path;
// records carry an immutable calculation snapshot and never change when the fee
// configuration later changes.

// Single active configuration row = the server-side source of truth for fees.
model PlatformFeeConfig {
  id                   String              @id @default(cuid())
  isActive             Boolean             @default(true)
  currency             Currency            @default(BZD)
  // Marketplace commission as basis points of the merchandise subtotal (1000 = 10%).
  commissionBps        Int                 @default(1000)
  driverEarningMethod  DriverEarningMethod @default(PERCENT_DELIVERY_FEE)
  // FLAT / HYBRID: fixed minor units the driver earns per completed delivery.
  driverFlatMinor      BigInt              @default(0)
  // PERCENT / HYBRID: driver's share of the delivery fee, basis points (8000 = 80%).
  driverDeliveryFeeBps Int                 @default(8000)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([isActive])
  @@map("platform_fee_configs")
}

// Platform operations announcement / maintenance banner (Phase 4 · M23). A single
// admin-managed row surfaced to the public banner. DISPLAY-ONLY — maintenanceMode is
// an informational notice, NOT an API gate (it never blocks requests).
enum AnnouncementLevel {
  INFO
  WARNING
  CRITICAL
}

model PlatformSetting {
  id                  String            @id @default(cuid())
  announcementActive  Boolean           @default(false)
  announcementLevel   AnnouncementLevel @default(INFO)
  announcementMessage String?
  maintenanceMode     Boolean           @default(false) // display-only notice; not an API gate
  maintenanceMessage  String?

  // ---- Automatic dispatch (M26.3 · Part 4) ----
  // Tunable without a deploy. Defaults mirror the constants in
  // @bmpl/shared/dispatch-ranking, so an untouched install behaves exactly as the
  // tested defaults describe. Extends the existing singleton rather than adding a
  // second settings table — one row, one admin screen, one cache to reason about.
  // Master switch. Defaults OFF: the engine ships before the vendor UI that
  // drives it, and a half-wired workflow must not start moving real customers'
  // orders. Flipped on once the whole path is production-verified.
  dispatchAutomatic              Boolean @default(false)
  dispatchOfferTimeoutSeconds    Int     @default(90)
  dispatchMaxOffers              Int     @default(5) // distinct drivers before escalating to a human
  dispatchMaxConcurrentPerDriver Int     @default(3)
  dispatchWeightWorkload         Int     @default(40)
  dispatchWeightFairness         Int     @default(30)
  dispatchWeightRating           Int     @default(15)
  dispatchWeightLocality         Int     @default(10)
  dispatchWeightExperience       Int     @default(5)

  // ---- Local courier pricing ----
  // What BML charges for a same-district door-to-door run, where one courier
  // does the whole job and no terminal is involved. Hub courier fees price a
  // run between a terminal and an address; this prices a run between two
  // addresses, which the hub fee cannot describe. Zero means "not priced yet",
  // and the quote says so rather than quietly quoting free.
  localCourierFeeMinor  BigInt @default(0)
  localCourierMinutes   Int    @default(0)

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("platform_settings")
}

model VendorSettlement {
  id                       String           @id @default(cuid())
  vendorProfileId          String
  vendorProfile            VendorProfile    @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  vendorOrderId            String           @unique
  vendorOrder              VendorOrder      @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  paymentId                String
  payment                  Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  currency                 Currency         @default(BZD)
  // Calculation components (minor units) — gross = merchandise + delivery fee.
  merchandiseSubtotalMinor BigInt
  deliveryFeeMinor         BigInt
  commissionMinor          BigInt
  driverAllocationMinor    BigInt
  platformFeeMinor         BigInt // platform's share of the delivery fee (+ future fees)
  grossMinor               BigInt
  netMinor                 BigInt // vendor net = merchandise − commission
  status                   SettlementStatus @default(PENDING)
  failureReason            String?
  // Immutable snapshot of the config + inputs used (never recomputed).
  snapshot                 Json
  walletTransactionId      String?
  calculatedAt             DateTime         @default(now())
  postedAt                 DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  driverEarnings DriverEarning[]

  @@index([vendorProfileId, status])
  @@index([paymentId])
  @@index([status])
  @@map("vendor_settlements")
}

model DriverEarning {
  id                  String              @id @default(cuid())
  driverProfileId     String
  driverProfile       DriverProfile       @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)
  orderDeliveryId     String              @unique
  orderDelivery       OrderDelivery       @relation(fields: [orderDeliveryId], references: [id], onDelete: Restrict)
  vendorOrderId       String
  settlementId        String?
  settlement          VendorSettlement?   @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  currency            Currency            @default(BZD)
  method              DriverEarningMethod
  grossMinor          BigInt
  // Future-ready (tips/bonuses/penalties) — always 0 in M18.
  adjustmentsMinor    BigInt              @default(0)
  netMinor            BigInt
  status              SettlementStatus    @default(PENDING)
  snapshot            Json
  walletTransactionId String?
  calculatedAt        DateTime            @default(now())
  postedAt            DateTime?
  createdAt           DateTime            @default(now())

  @@index([driverProfileId, status])
  @@map("driver_earnings")
}

// A verified customer review of a product / vendor / driver, tied to a completed
// transaction. User ids are plain (no FK) — users are never hard-deleted.
model Review {
  id               String            @id @default(cuid())
  reviewerId       String
  subjectType      ReviewSubjectType
  subjectId        String // productId / vendorProfileId / driverProfileId
  contextType      ReviewContextType
  contextId        String // orderItemId / vendorOrderId / orderDeliveryId (proves eligibility)
  rating           Int // 1..5
  title            String?
  body             String
  status           ReviewStatus      @default(PUBLISHED)
  verifiedPurchase Boolean           @default(true)
  helpfulCount     Int               @default(0) // cache; recomputable from votes
  // Product-review variant snapshot (so a "Perfect in Pink" review never mislabels).
  productId        String?
  variantId        String?
  variantName      String?
  sku              String?
  optionsSnapshot  Json?
  // Moderation.
  moderatedById    String?
  moderationReason String?
  moderatedAt      DateTime?
  editedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // The author. `reviewerId` predates this relation (it was a bare column); the
  // relation exists so a published review can show who wrote it — name and face —
  // rather than an anonymous star rating.
  reviewer User @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)

  media    ReviewMedia[]
  response ReviewResponse?
  reports  ReviewReport[]
  votes    ReviewHelpfulVote[]

  // One active review per reviewer per verified context (dup prevention).
  @@unique([reviewerId, subjectType, contextId])
  @@index([subjectType, subjectId, status])
  @@index([reviewerId])
  @@index([status])
  @@map("reviews")
}

model ReviewMedia {
  id            String            @id @default(cuid())
  reviewId      String
  review        Review            @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  storageKey    String            @unique // private bucket
  mimeType      String
  fileSizeBytes Int
  status        ReviewMediaStatus @default(APPROVED)
  createdAt     DateTime          @default(now())

  @@index([reviewId])
  @@map("review_media")
}

model ReviewResponse {
  id          String    @id @default(cuid())
  reviewId    String    @unique
  review      Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  responderId String // vendor user id
  body        String
  editedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@map("review_responses")
}

model ReviewReport {
  id             String             @id @default(cuid())
  reviewId       String
  review         Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId     String
  reason         ReviewReportReason
  note           String?
  status         ReviewReportStatus @default(OPEN)
  resolvedById   String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime           @default(now())

  @@unique([reviewId, reporterId]) // one report per user per review
  @@index([status])
  @@map("review_reports")
}

model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@map("review_helpful_votes")
}

// ---- Saved Products (Wishlists) & Recently Viewed (Phase 4 · M20) ----

// A customer's saved/wishlisted product. Product-level (variant chosen at add-to-cart
// time). One row per (user, product); saving never reserves stock or moves money.
model SavedProduct {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // The EXACT saved commerce item: null for a product-level wishlist entry, set for
  // a specific variant. variantId is the primary identity for variant items, so a
  // customer can wishlist different variants of the same parent independently.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  // Variant entries are unique per (user, variant). Product-level entries (variantId
  // NULL) are made unique per (user, product) by a PARTIAL unique index in the
  // migration (Postgres treats NULLs as distinct, so this composite only constrains
  // non-null variant rows).
  @@unique([userId, variantId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("saved_products")
}

// A customer's "notify me when back in stock" subscription for an exact product or
// variant. One-shot: when the item is restocked above zero the subscriber is notified
// and the row is removed, so a fresh subscription is needed for the next restock.
// Unique per (user, variant); product-level (variantId NULL) unique per (user, product)
// via a partial index (Postgres treats NULLs as distinct).
model BackInStockSubscription {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, variantId])
  @@index([productId, variantId])
  @@index([userId])
  @@map("back_in_stock_subscriptions")
}

// A customer's recently-viewed product history (own data only, never exposed to
// vendors/others). Upserted on view; capped to the newest N per user.
model RecentlyViewedProduct {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed_products")
}

model DriverVehicle {
  id                    String                @id @default(cuid())
  driverProfileId       String
  driverProfile         DriverProfile         @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  type                  VehicleType
  make                  String
  model                 String
  year                  Int?
  color                 String?
  licencePlate          String
  registrationNumber    String?
  registrationExpiry    DateTime?
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceExpiry       DateTime?
  photoKeys             String[] // private-bucket storage keys (photos, not core data)
  isActive              Boolean               @default(true)
  isPrimary             Boolean               @default(false)
  approvalStatus        VehicleApprovalStatus @default(PENDING)
  rejectionReason       String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Dispatch (M15): deliveries currently using this vehicle + assignment history.
  activeDeliveries    OrderDelivery[]      @relation("VehicleActiveDeliveries")
  activeShipmentLegs  ShipmentLeg[]        @relation("VehicleShipmentLegs")
  shipmentLegOffers   ShipmentLegOffer[]   @relation("VehicleShipmentLegOffers")
  deliveryAssignments DeliveryAssignment[]

  @@index([driverProfileId])
  @@index([approvalStatus])
  @@map("driver_vehicles")
}

model DriverServiceArea {
  id              String        @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  district        District
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([driverProfileId, district])
  @@index([driverProfileId])
  @@map("driver_service_areas")
}

model OrderItem {
  id             String          @id @default(cuid())
  vendorOrderId  String
  vendorOrder    VendorOrder     @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  // Live references kept for future linkage; the SNAPSHOT fields below are the
  // source of truth so order history survives product/variant deletion.
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productTitle   String
  variantTitle   String?
  sku            String?
  unitPriceMinor BigInt
  quantity       Int
  subtotalMinor  BigInt
  currency       Currency        @default(BZD)
  createdAt      DateTime        @default(now())

  @@index([vendorOrderId])
  @@index([productId])
  @@map("order_items")
}

// An address the customer has chosen to keep.
//
// Stores BOTH the human-readable address and the coordinate, because in Belize
// they carry different information: the text is what a person recognises, and
// the pin is what a driver can actually navigate to. Neither substitutes for
// the other, so neither is derived from the other.
//
// Snapshots taken at checkout or booking are separate rows (OrderAddress, and
// the origin/destination columns on Shipment). Editing a saved address must
// never reshape an order that has already been placed.
model SavedAddress {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // What the customer calls it: "Home", "The shop", "Mum's place".
  label     String
  fullName  String
  phone     String
  email     String?
  company   String?

  addressLine1 String
  addressLine2 String?
  city         String
  district     District
  country      String   @default("BZ")
  instructions String?

  latitude  Float?
  longitude Float?

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDefault])
  @@map("saved_addresses")
}

model OrderAddress {
  id           String           @id @default(cuid())
  orderId      String
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type         OrderAddressType @default(SHIPPING)
  fullName     String
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String
  district     District
  country      String           @default("BZ")
  latitude     Float?
  longitude    Float?
  createdAt    DateTime         @default(now())

  @@index([orderId])
  @@map("order_addresses")
}

// ---- Marketplace: Payments & wallet holds (Phase 3 · M11) -------------------
// FOUNDATION ONLY. This is the complete financial ARCHITECTURE, but no money
// moves: no wallet ledger entries are written, no balances change, and no
// capture/settlement occurs. A checkout creates a Payment (CREATED→PENDING), a
// soft WalletHold (HELD — a reservation of intent, NOT an escrow ledger entry),
// and a forward-looking LedgerReference (PENDING — the planned movement, unposted).
// Idempotency on checkout prevents duplicate payments under distributed retries.
// The design is gateway-agnostic (wallet / card / bank) without schema redesign.

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  // Internal financial completion (M18). SETTLING = at least one vendor-order of a
  // multi-vendor order has been settled; SETTLED = every vendor-order settled.
  SETTLING
  SETTLED
  FAILED
  EXPIRED
  CANCELLED
}

// ---- Settlement (Phase 3 · M18 — internal escrow distribution, no payouts) ----
// Driver earning calculation basis (configurable via PlatformFeeConfig).
enum DriverEarningMethod {
  FLAT
  PERCENT_DELIVERY_FEE
  HYBRID
}

// Lifecycle of a VendorSettlement / DriverEarning. Posting is atomic with the
// balanced escrow-release ledger transaction.
enum SettlementStatus {
  PENDING
  POSTED
  FAILED
}

enum PaymentMethodType {
  WALLET
  CREDIT_CARD
  BANK_TRANSFER
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  AUTHORIZED
  FAILED
}

enum WalletHoldStatus {
  HELD
  AUTHORIZED
  RELEASED
}

enum PaymentEventType {
  CREATED
  STATE_CHANGED
  HOLD_CREATED
  HOLD_RELEASED
  IDEMPOTENT_REPLAY
}

enum LedgerReferenceStatus {
  PENDING
  POSTED
  VOID
}

enum LedgerReferencePurpose {
  CUSTOMER_PAYMENT
}

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
}

// A customer's payment instrument. M11 provisions a WALLET method; card/bank
// fields are present but null until a gateway is integrated (no schema redesign).
model PaymentMethod {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               PaymentMethodType
  label              String?
  isDefault          Boolean           @default(false)
  brand              String? // e.g. Visa (future)
  last4              String? // future
  gatewayCustomerRef String? // future third-party gateway id
  gatewayMethodRef   String? // future
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  payments Payment[]

  @@unique([userId, type])
  @@index([userId])
  @@map("payment_methods")
}

// One payment per Order (the customer pays for an order). Connected to the wallet
// via WalletHold + LedgerReference; to vendor orders transitively via Order.
model Payment {
  id               String            @id @default(cuid())
  paymentNumber    String            @unique
  orderId          String            @unique
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMinor      BigInt // == order.totalMinor
  currency         Currency          @default(BZD)
  status           PaymentStatus     @default(CREATED)
  methodType       PaymentMethodType @default(WALLET)
  paymentMethodId  String?
  paymentMethod    PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  idempotencyKeyId String?           @unique
  idempotencyKey   IdempotencyKey?   @relation(fields: [idempotencyKeyId], references: [id], onDelete: SetNull)
  authorizedAt     DateTime?
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  attempts    PaymentAttempt[]
  events      PaymentEvent[]
  holds       WalletHold[]
  ledgerRefs  LedgerReference[]
  settlements VendorSettlement[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("payments")
}

// A gateway/processing attempt. Foundation table — no rows are created in M11
// (attempts belong to authorization/capture, a later milestone).
model PaymentAttempt {
  id             String               @id @default(cuid())
  paymentId      String
  payment        Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status         PaymentAttemptStatus @default(CREATED)
  gateway        String?
  gatewayRef     String?
  failureCode    String?
  failureMessage String?
  createdAt      DateTime             @default(now())

  @@index([paymentId])
  @@map("payment_attempts")
}

// A SOFT hold reserving the customer's intent to pay from their wallet. It does
// NOT create a ledger entry and does NOT change the wallet balance (no escrow in
// M11). Release tracking via status + releasedAt.
model WalletHold {
  id                  String           @id @default(cuid())
  paymentId           String
  payment             Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  walletAccountId     String
  walletAccount       WalletAccount    @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  amountMinor         BigInt
  currency            Currency         @default(BZD)
  status              WalletHoldStatus @default(HELD)
  // Set when the hold is AUTHORIZED — the customer→escrow WalletTransaction that
  // backs it (M12). Null while the hold is a soft (HELD) reservation.
  walletTransactionId String?
  heldAt              DateTime         @default(now())
  authorizedAt        DateTime?
  releasedAt          DateTime?
  releaseReason       String?
  createdAt           DateTime         @default(now())

  @@index([paymentId])
  @@index([walletAccountId, status])
  @@map("wallet_holds")
}

// A forward link from a payment to a PLANNED wallet ledger movement. In M11 the
// movement is not posted (status PENDING; walletTransactionId/walletLedgerEntryId
// null). Capture (later) fills these and flips status to POSTED — no schema change.
model LedgerReference {
  id                  String                 @id @default(cuid())
  paymentId           String
  payment             Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  walletAccountId     String
  walletAccount       WalletAccount          @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  purpose             LedgerReferencePurpose
  direction           LedgerDirection // intended DEBIT of the customer wallet
  amountMinor         BigInt
  currency            Currency               @default(BZD)
  status              LedgerReferenceStatus  @default(PENDING)
  // Filled when the movement is actually posted (future). Not FK-constrained so a
  // reference can exist before any wallet transaction does.
  walletTransactionId String?
  walletLedgerEntryId String?
  postedAt            DateTime?
  createdAt           DateTime               @default(now())

  @@index([paymentId])
  @@index([walletAccountId])
  @@map("ledger_references")
}

// Append-only event log for a payment (its own trail, in addition to AuditLog).
model PaymentEvent {
  id         String           @id @default(cuid())
  paymentId  String
  payment    Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type       PaymentEventType
  fromStatus PaymentStatus?
  toStatus   PaymentStatus?
  data       Json?
  createdAt  DateTime         @default(now())

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

// Idempotency for checkout/payment initiation. A duplicate (user, scope, key)
// returns the original result instead of creating a second order/payment —
// safe under distributed retries.
model IdempotencyKey {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope           String // e.g. "checkout"
  key             String
  requestHash     String?
  status          IdempotencyKeyStatus @default(IN_PROGRESS)
  resultOrderId   String?
  resultPaymentId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  payment Payment?

  @@unique([userId, scope, key])
  @@index([userId])
  @@map("idempotency_keys")
}

// ============================================================================
// Belize Connect — Jobs & Employment (Phase 5 · M24)
// Reuses the BMPL account, JOB_SEEKER/EMPLOYER roles + role-application approval,
// messaging, notifications, storage, search, moderation, analytics, and audit.
// Fully normalized (no JSON blobs).
// ============================================================================

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  SEASONAL
  APPRENTICESHIP
  VOLUNTEER
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum EducationLevel {
  NONE
  PRIMARY
  SECONDARY
  VOCATIONAL
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
}

enum SalaryPeriod {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
}

enum SalaryVisibility {
  HIDDEN
  RANGE
  EXACT
}

enum JobStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  APPROVED
  PUBLISHED
  REJECTED
  CLOSED
  ARCHIVED
  SUSPENDED
}

enum JobApplicationMethod {
  INTERNAL
  EXTERNAL_URL
  EMAIL
}

enum JobApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_REQUESTED
  INTERVIEW_SCHEDULED
  OFFER_EXTENDED
  HIRED
  REJECTED
  WITHDRAWN
}

enum JobQuestionType {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  NUMBER
  DATE
}

enum JobSeekerVisibility {
  PRIVATE
  EMPLOYERS_ONLY
  PUBLIC_SUMMARY
}

enum SeekerEmploymentStatus {
  OPEN_TO_WORK
  EMPLOYED
  UNEMPLOYED
  STUDENT
  NOT_LOOKING
}

enum InterviewMode {
  IN_PERSON
  PHONE
  VIDEO
}

enum InterviewStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum JobReportReason {
  SCAM
  MISLEADING
  DISCRIMINATION
  ILLEGAL
  PRIVACY
  DUPLICATE
  EXPIRED
  OTHER
}

enum JobReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

// Admin-managed job category lookup (mirrors the marketplace Category pattern).
model JobCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs JobListing[]

  @@index([isVisible])
  @@map("job_categories")
}

// ---- Job Seeker profile (normalized) ----
model JobSeekerProfile {
  id                 String                 @id @default(cuid())
  userId             String                 @unique
  user               User                   @relation("UserJobSeekerProfile", fields: [userId], references: [id], onDelete: Cascade)
  preferredName      String
  legalName          String?
  headline           String?
  summary            String?
  district           District?
  contactEmail       String?
  contactPhone       String?
  employmentStatus   SeekerEmploymentStatus @default(OPEN_TO_WORK)
  preferredTypes     EmploymentType[]
  preferredDistricts District[]
  remotePreference   WorkArrangement?
  availabilityDate   DateTime?
  salaryExpectMinor  BigInt?
  salaryCurrency     Currency               @default(BZD)
  salaryPeriod       SalaryPeriod?
  salaryExpectPublic Boolean                @default(false)
  visibility         JobSeekerVisibility    @default(PRIVATE)
  photoKey           String? // private storage key; signed URL only
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  skills         JobSeekerSkill[]
  education      JobSeekerEducation[]
  experience     JobSeekerExperience[]
  certifications JobSeekerCertification[]
  languages      JobSeekerLanguage[]
  resumes        JobSeekerResume[]

  @@index([visibility])
  @@index([district])
  @@map("job_seeker_profiles")
}

model JobSeekerSkill {
  id        String           @id @default(cuid())
  profileId String
  profile   JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())

  @@unique([profileId, name])
  @@index([profileId])
  @@map("job_seeker_skills")
}

model JobSeekerEducation {
  id           String           @id @default(cuid())
  profileId    String
  profile      JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution  String
  level        EducationLevel?
  fieldOfStudy String?
  startYear    Int?
  endYear      Int?
  current      Boolean          @default(false)
  createdAt    DateTime         @default(now())

  @@index([profileId])
  @@map("job_seeker_education")
}

model JobSeekerExperience {
  id          String           @id @default(cuid())
  profileId   String
  profile     JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  company     String
  district    District?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean          @default(false)
  description String?
  createdAt   DateTime         @default(now())

  @@index([profileId])
  @@map("job_seeker_experience")
}

model JobSeekerCertification {
  id         String           @id @default(cuid())
  profileId  String
  profile    JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  issuer     String?
  issuedYear Int?
  createdAt  DateTime         @default(now())

  @@index([profileId])
  @@map("job_seeker_certifications")
}

model JobSeekerLanguage {
  id          String           @id @default(cuid())
  profileId   String
  profile     JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  proficiency String?
  createdAt   DateTime         @default(now())

  @@unique([profileId, name])
  @@index([profileId])
  @@map("job_seeker_languages")
}

// A resume/CV file in PRIVATE R2. Served only via signed URLs to the owner,
// employers whose job the owner applied to, and permitted admins.
model JobSeekerResume {
  id            String               @id @default(cuid())
  profileId     String
  profile       JobSeekerProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label         String
  storageKey    String               @unique
  mimeType      String
  fileSizeBytes Int
  scanStatus    AttachmentScanStatus @default(PENDING)
  isPrimary     Boolean              @default(false)
  createdAt     DateTime             @default(now())

  applications JobApplication[]

  @@index([profileId])
  @@map("job_seeker_resumes")
}

// ---- Employer / Company profile (mirrors VendorProfile; approval via EMPLOYER role) ----
model EmployerProfile {
  id             String               @id @default(cuid())
  userId         String               @unique
  user           User                 @relation("UserEmployerProfile", fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  legalName      String?
  slug           String               @unique
  description    String?
  industry       String?
  companySize    String?
  contactEmail   String
  contactPhone   String?
  website        String?
  district       District?
  addressLine1   String?
  addressLine2   String?
  city           String?
  logoKey        String?
  bannerKey      String?
  approvalStatus VendorApprovalStatus @default(DRAFT)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  jobs             JobListing[]
  promotionTargets PromotionTarget[]

  @@index([approvalStatus])
  @@map("employer_profiles")
}

// ---- Job listing (normalized) ----
model JobListing {
  id                      String               @id @default(cuid())
  employerProfileId       String
  employerProfile         EmployerProfile      @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  jobCategoryId           String?
  jobCategory             JobCategory?         @relation(fields: [jobCategoryId], references: [id], onDelete: SetNull)
  title                   String
  slug                    String               @unique
  employmentType          EmploymentType
  workArrangement         WorkArrangement      @default(ONSITE)
  district                District?
  city                    String?
  remoteEligible          Boolean              @default(false)
  description             String
  responsibilities        String?
  requirements            String?
  preferredQualifications String?
  experienceLevel         ExperienceLevel?
  educationLevel          EducationLevel?
  salaryMinMinor          BigInt?
  salaryMaxMinor          BigInt?
  salaryCurrency          Currency             @default(BZD)
  salaryPeriod            SalaryPeriod?
  salaryVisibility        SalaryVisibility     @default(HIDDEN)
  openings                Int                  @default(1)
  applicationDeadline     DateTime?
  startDate               DateTime?
  applicationMethod       JobApplicationMethod @default(INTERNAL)
  externalUrl             String?
  applicationEmail        String?
  status                  JobStatus            @default(DRAFT)
  moderationReason        String?
  moderatedById           String?
  moderatedAt             DateTime?
  publishedAt             DateTime?
  closedAt                DateTime?
  archivedAt              DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  skills           JobSkill[]
  benefits         JobBenefit[]
  questions        JobApplicationQuestion[]
  applications     JobApplication[]
  reports          JobReport[]
  savedBy          SavedJob[]
  viewedBy         RecentlyViewedJob[]
  promotionTargets PromotionTarget[]

  @@index([status, publishedAt])
  @@index([employerProfileId, status])
  @@index([jobCategoryId])
  @@index([district])
  @@map("job_listings")
}

model JobSkill {
  id        String     @id @default(cuid())
  jobId     String
  job       JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  required  Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@unique([jobId, name])
  @@index([jobId])
  @@map("job_skills")
}

model JobBenefit {
  id        String     @id @default(cuid())
  jobId     String
  job       JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())

  @@index([jobId])
  @@map("job_benefits")
}

// Employer-authored custom application question. Wording/options are snapshotted
// onto each answer at submit time so later edits never alter historical applications.
model JobApplicationQuestion {
  id        String          @id @default(cuid())
  jobId     String
  job       JobListing      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  prompt    String
  type      JobQuestionType
  required  Boolean         @default(false)
  options   String[] // for SINGLE_CHOICE / MULTIPLE_CHOICE
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  answers JobApplicationAnswer[]

  @@index([jobId])
  @@map("job_application_questions")
}

// ---- Job application ----
model JobApplication {
  id               String               @id @default(cuid())
  jobId            String
  job              JobListing           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId      String
  applicant        User                 @relation("ApplicantApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  resumeId         String?
  resume           JobSeekerResume?     @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter      String?
  status           JobApplicationStatus @default(SUBMITTED)
  employerNotes    String? // PRIVATE to the employer — never exposed to the applicant
  source           String?
  // Snapshot at submission so history survives job/company edits or deletion.
  jobTitleSnapshot String
  companySnapshot  String
  submittedAt      DateTime             @default(now())
  withdrawnAt      DateTime?
  updatedAt        DateTime             @updatedAt

  answers    JobApplicationAnswer[]
  events     JobApplicationEvent[]
  interviews JobInterview[]

  // One ACTIVE application per (job, applicant) is enforced in the service; a
  // withdrawn application may be re-applied (documented policy).
  @@index([jobId, status])
  @@index([applicantId, submittedAt])
  @@map("job_applications")
}

model JobApplicationAnswer {
  id             String                  @id @default(cuid())
  applicationId  String
  application    JobApplication          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId     String?
  question       JobApplicationQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  // Snapshot of the question wording/type at submit time (immutable history).
  promptSnapshot String
  typeSnapshot   JobQuestionType
  answerText     String?
  answerChoices  String[]
  createdAt      DateTime                @default(now())

  @@index([applicationId])
  @@map("job_application_answers")
}

// Append-only status/pipeline history for an application.
model JobApplicationEvent {
  id            String                @id @default(cuid())
  applicationId String
  application   JobApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    JobApplicationStatus?
  toStatus      JobApplicationStatus
  actorId       String?
  note          String?
  createdAt     DateTime              @default(now())

  @@index([applicationId, createdAt])
  @@map("job_application_events")
}

model JobInterview {
  id            String          @id @default(cuid())
  applicationId String
  application   JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  timezone      String          @default("America/Belize")
  mode          InterviewMode
  location      String? // address or meeting link (no external integration in M24)
  notes         String?
  status        InterviewStatus @default(SCHEDULED)
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([applicationId])
  @@map("job_interviews")
}

// ---- Saved jobs & recently viewed (mirrors M20 engagement) ----
model SavedJob {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, jobId])
  @@index([userId, createdAt])
  @@map("saved_jobs")
}

model RecentlyViewedJob {
  id       String     @id @default(cuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId    String
  job      JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  viewedAt DateTime   @default(now())

  @@unique([userId, jobId])
  @@index([userId, viewedAt])
  @@map("recently_viewed_jobs")
}

// ---- Job reports (M23 moderation pattern) ----
model JobReport {
  id             String          @id @default(cuid())
  jobId          String
  job            JobListing      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporterId     String
  reason         JobReportReason
  note           String?
  status         JobReportStatus @default(OPEN)
  resolvedById   String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())

  @@unique([jobId, reporterId])
  @@index([status])
  @@map("job_reports")
}

// ============================================================================
// Real Estate (Phase 6 · M25)
// Reuses the BMPL account, REAL_ESTATE_AGENT/PROPERTY_OWNER roles + role-application
// approval, messaging, notifications, storage, search, moderation, analytics, audit.
// Fully normalized (no JSON blobs). Location privacy: exact address stored separately
// and never public unless the visibility policy allows.
// ============================================================================

enum ListingPurpose {
  FOR_SALE
  FOR_RENT
}

enum PropertyType {
